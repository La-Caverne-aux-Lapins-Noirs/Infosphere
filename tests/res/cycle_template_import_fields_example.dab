      ]
      [Tools
        Software = "valgrind"
        Type = "Tools"
      ]
    ]

    [Sessions
      [Morning
        Week = 0
        Day = "Monday"
        Begin = "09:00"
        End = "12:00"
        {Rooms
          "DOROTHY-VAUGHAN"
        }
      ]
    ]
  ]
]

[Matters
