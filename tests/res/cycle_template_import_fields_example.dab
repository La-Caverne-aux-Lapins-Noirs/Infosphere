    [EmergenceDate
      Week = 0
      Day = "Monday"
      Time = "08:30"
    ]
    [SubjectAppeirDate
      Week = 0
      Day = "Monday"
      Time = "09:00"
    ]
    [PickupDate
      Week = 0
      Day = "Monday"
      Time = "12:00"
    ]

    [Fr
      Name = "TP d'algorithmique"
      Description = "Mise en pratique"
      Objective = "Résoudre le problème demandé"
      Method = "Travail pratique"
      Reference = "Support ALG"
    ]

    {Teachers
      "teacher-a"
    }
    {Laboratories
