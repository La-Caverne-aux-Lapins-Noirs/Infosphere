    <?php require (__DIR__."/external_calendar.phtml"); ?>

    <?php if (is_intranet_member_profile()) { ?>
        <?php
        // User public data normally already contains laboratories.  Calling
        // get_user_laboratories() again when that key exists historically
        // returns the complete user array, not the laboratory list.
        if (isset($User["laboratories"]) && is_array($User["laboratories"]))
            $calendar_laboratories = $User["laboratories"];
        else
            $calendar_laboratories = get_user_laboratories($User);

        // print_control_buttons() explicitly imports $Language. Keep a safe
        // fallback nevertheless, so this query can never degrade to `_name`.
        $calendar_language = in_array($Language, ["fr", "en"], true) ? $Language : "fr";
        $calendar_room_name_column = $calendar_language."_name";
        $calendar_rooms = db_select_all("
            id, codename, $calendar_room_name_column as name
            FROM room
            WHERE deleted IS NULL
            ORDER BY COALESCE(NULLIF($calendar_room_name_column, ''), codename) ASC
        ");
        ?>
        <details class="calendar_standalone_creator">
            <summary title="Ajouter un événement personnel ou de laboratoire">+ Événement</summary>
            <form
                method="post"
                action="/api/session"
                onsubmit="return silent_submitf(this, {after_success: function () { window.location.reload(); }});"
            >
                <input type="text" name="name" placeholder="Nom de l'événement" required />
                <select name="standalone_target" required>
                    <option value="user:<?=(int)$User["id"]; ?>">Personnel</option>
                    <?php foreach ($calendar_laboratories as $lab) { ?>
                        <?php if ((int)$lab["authority"] < ASSISTANT) continue ; ?>
                        <option value="laboratory:<?=(int)$lab["id"]; ?>">
                            Laboratoire — <?=htmlspecialchars(trim((string)$lab["name"]) != "" ? $lab["name"] : $lab["codename"]); ?>
                        </option>
                    <?php } ?>
                </select>
                <div class="calendar_standalone_time">
                    <input type="date" name="day" value="<?=datex("Y-m-d", time()); ?>" required />
                    <input type="time" name="begin" required />
                    <input type="time" name="end" required />
                </div>
                <select name="room">
                    <option value="">Sans salle</option>
                    <?php foreach ($calendar_rooms as $room) { ?>
                        <option value="<?=(int)$room["id"]; ?>">
                            <?=htmlspecialchars(trim((string)$room["name"]) != "" ? $room["name"] : $room["codename"]); ?>
                        </option>
                    <?php } ?>
                </select>
                <input type="submit" value="Créer" />
            </form>
        </details>
    <?php } ?>

