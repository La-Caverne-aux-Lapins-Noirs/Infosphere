                />
                <input
                    type="button"
                    value="Copier"
                    onclick="navigator.clipboard.writeText(document.getElementById('external_calendar_url').value);"
                />
            </div>

            <div class="calendar_external_actions">
                <a
                    class="calendar_external_button"
                    href="<?=htmlspecialchars(preg_replace('/^https?:/', 'webcal:', $calendar_url), ENT_QUOTES, "UTF-8"); ?>"
                >Ouvrir</a>
                <form action="index.php?p=<?=$Position; ?>" method="post">
