<script>
function title_session_filter_managers(form)
{
    var school = form.querySelector('[name="id_school"]');
    var managers = form.querySelector('[data-title-session-manager-select]');
    var selectedSchool = school ? school.value : '';

    if (!managers)
        return ;
    Array.prototype.forEach.call(managers.options, function(option) {
        var optionSchool = option.getAttribute('data-school');
        var visible = optionSchool === null || optionSchool == selectedSchool;
        option.hidden = !visible;
        option.disabled = !visible;
    });
    if (managers.selectedOptions.length && managers.selectedOptions[0].disabled)
        managers.value = '';
}
</script>
