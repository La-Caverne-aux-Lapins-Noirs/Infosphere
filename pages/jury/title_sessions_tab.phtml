function title_session_manager_label(array $user)
{
    $name = trim(($user["first_name"] ?? "")." ".($user["family_name"] ?? ""));
    if ($name == "")
        $name = trim((string)($user["nickname"] ?? ""));
    if ($name == "")
        $name = $user["codename"] ?? "";
    return ($name);
}

function title_session_document_hidden($model, array $chain)
{
    $hash = preg_replace('/[^a-zA-Z0-9_]/', '_', $model);
    ?>
    <input type="hidden" name="doc_<?=$hash; ?>" value="1" />
    <input type="hidden" name="docref_<?=$hash; ?>" value="res_docs:fr/<?=htmlspecialchars($model, ENT_QUOTES); ?>.dab" />
    <input type="hidden" name="chain" value="<?=htmlspecialchars(json_encode($chain, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), ENT_QUOTES); ?>" />
    <?php
}

function title_session_base_document_chain(array $session)
{
    $chain = [
        ["type" => "school", "prefix" => "School", "id" => (string)$session["id_school"]],
        ["type" => "title_session", "prefix" => "TitleSession", "id" => (string)$session["id"]],
    ];
    if ((int)($session["id_session_manager"] ?? 0) > 0)
        $chain[] = [
            "type" => "user",
            "prefix" => "SessionManager",
            "id" => (string)$session["id_session_manager"],
            "signatory" => "SessionManager",
        ];
    return ($chain);
}
