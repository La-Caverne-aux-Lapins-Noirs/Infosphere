<script>
function jury_filter_list()
{
    var cert = document.getElementById('jury_certification_filter');
    var mode = document.getElementById('jury_certification_filter_mode');
    var search = document.getElementById('jury_text_filter');
    var selected = cert ? cert.value : '';
    var m = mode ? mode.value : 'has';
    var needle = search ? search.value.toLowerCase().trim() : '';
    var rows = document.querySelectorAll('.jury_row');

    rows.forEach(function(row) {
        var titles = row.getAttribute('data-jury-titles') || '';
        var text = (row.textContent || '').toLowerCase();
        var ok = true;

        if (selected != '')
        {
            var has = titles.indexOf(';' + selected + ';') != -1;
            ok = (m == 'missing') ? !has : has;
        }
        if (needle != '' && text.indexOf(needle) == -1)
            ok = false;
        row.style.display = ok ? '' : 'none';
    });
}
</script>

