<?php
$jury_session_groups = [
    ($Dictionnary["UpcomingSessions"] ?? "À venir") => $jury["sessions_upcoming"] ?? [],
    ($Dictionnary["PastSessions"] ?? "Passées") => $jury["sessions_past"] ?? []
];
?>
<div class="jury_sessions">
    <?php foreach ($jury_session_groups as $label => $sessions) { ?>
        <div class="jury_session_group">
            <b><?=$label; ?></b>
            <?php if (!count($sessions)) { ?>
                <span class="smalltext">/</span>
            <?php } else { ?>
                <ul>
                    <?php foreach ($sessions as $sess) { ?>
                        <li>
                            <span><?=htmlentities(title_session_date_value($sess["start_date"])); ?> → <?=htmlentities(title_session_date_value($sess["end_date"])); ?></span>
                            —
                            <span><?=htmlentities($sess["title_name"] ?: $sess["title_codename"]); ?></span>
                            <span class="smalltext">#<?=$sess["id_title_session"]; ?></span>
                        </li>
                    <?php } ?>
                </ul>
            <?php } ?>
        </div>
    <?php } ?>
</div>
