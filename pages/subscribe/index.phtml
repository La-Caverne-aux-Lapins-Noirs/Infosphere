<script>
 function check_repeat(rep, ori)
 {
     if (rep.value != ori.value)
         rep.style.backgroundColor = "red";
     else
         rep.style.backgroundColor = null;
 }
 function check_relation_selection(form)
 {
     if (!form.querySelector('input[name="relation[]"]:checked'))
     {
         set_error_div("Sélectionnez au moins un type de relation.");
         return false;
     }
     return true;
 }
</script>
