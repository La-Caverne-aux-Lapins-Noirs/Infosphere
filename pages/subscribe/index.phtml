<?php
function pf($str)
{
    $value = isset($_POST[$str]) ? (string)$_POST[$str] : "";
    return ('value="'.htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8").'"');
}

function pselected($name, $value, $default = NULL)
{
    if (isset($_POST[$name]))
        return ((string)$_POST[$name] === (string)$value ? "selected" : "");
    return ($default !== NULL && (string)$default === (string)$value ? "selected" : "");
}

$relation_target = isset($_GET["relation"]) ? (int)$_GET["relation"] : 0;
$relation_mode = $relation_target > 0;
$prospect = !$relation_mode && isset($_GET["prospect"]) && $_GET["prospect"];
$relation_target_name = "";

if ($relation_mode)
{
    if (!logged_in() || (!is_commercial() && !is_identity_authority_for_user($relation_target)))
    {
        echo "<p>Vous n'êtes pas autorisé à ajouter une relation à cet utilisateur.</p>";
        return ;
    }
    $relation_target_user = db_select_one("\n        id, codename, first_name, family_name\n        FROM user\n        WHERE id = $relation_target\n          AND authority != -1\n    ");
    if ($relation_target_user == NULL)
    {
        echo "<p>Utilisateur introuvable.</p>";
        return ;
    }
    $relation_target_name = trim(($relation_target_user["first_name"] ?? "")." ".($relation_target_user["family_name"] ?? ""));
    if ($relation_target_name == "")
        $relation_target_name = $relation_target_user["codename"];
}

if (!$Configuration->Properties["subscription_possible"] && !$prospect && !$relation_mode)
    $prospect = true;
