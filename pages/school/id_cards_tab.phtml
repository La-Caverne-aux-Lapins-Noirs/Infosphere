<script>
function schoolIdCardRefreshPreview(id)
{
    var image = document.getElementById("school-id-card-preview-" + id);
    if (!image)
        return;
    var base = image.src.split("?")[0];
    image.src = base + "?rev=" + Date.now();
}

function schoolIdCardRefreshSheetState(form)
{
    if (!form)
        return;
    var slots = Array.from(form.querySelectorAll("[data-id-card-slot]"));
    var used = slots.filter(function (slot) { return slot.classList.contains("is_used"); });
    var selected = Array.from(form.querySelectorAll('input[name="students[]"]:checked'));
    var free = Math.max(0, slots.length - used.length);
    var skip = used.map(function (slot) { return slot.getAttribute("data-id-card-slot"); });
    var skipInput = form.querySelector("[data-id-card-sheet-skip]");
    if (skipInput)
        skipInput.value = skip.join(",");

    var counter = form.querySelector("[data-id-card-sheet-counter]");
    if (counter)
        counter.textContent = selected.length + " carte(s) sélectionnée(s) · " + free + " emplacement(s) libre(s)";

    var overflow = selected.length > free;
    var overflowMessage = form.querySelector("[data-id-card-sheet-overflow]");
    if (overflowMessage)
        overflowMessage.hidden = !overflow;
    var schoolReady = <?=json_encode((bool)$id_card_status["ready"]); ?>;
    form.querySelectorAll("[data-id-card-sheet-generate]").forEach(function (submit) {
        submit.disabled = !schoolReady || selected.length === 0 || overflow;
    });
}

function schoolIdCardToggleSheetSlot(button)
{
    if (!button)
        return;
    var used = !button.classList.contains("is_used");
    button.classList.toggle("is_used", used);
    button.setAttribute("aria-pressed", used ? "true" : "false");
    var state = button.querySelector("[data-id-card-slot-state]");
    if (state)
        state.textContent = used
            ? <?=json_encode($Dictionnary["IdCardSheetUsed"] ?? "Utilisée", JSON_UNESCAPED_UNICODE); ?>
            : <?=json_encode($Dictionnary["IdCardSheetFree"] ?? "Libre", JSON_UNESCAPED_UNICODE); ?>;
    schoolIdCardRefreshSheetState(button.form);
}

function schoolIdCardResetSheetSlots(form)
{
    if (!form)
        return;
    form.querySelectorAll("[data-id-card-slot]").forEach(function (slot) {
        slot.classList.remove("is_used");
        slot.setAttribute("aria-pressed", "false");
        var state = slot.querySelector("[data-id-card-slot-state]");
        if (state)
            state.textContent = <?=json_encode($Dictionnary["IdCardSheetFree"] ?? "Libre", JSON_UNESCAPED_UNICODE); ?>;
    });
    schoolIdCardRefreshSheetState(form);
}

function schoolIdCardSelectSheetStudents(form, checked)
{
    if (!form)
        return;
    form.querySelectorAll('input[name="students[]"]').forEach(function (input) {
        input.checked = checked;
    });
    schoolIdCardRefreshSheetState(form);
}

function schoolIdCardPrepareSheet(form)
{
    schoolIdCardRefreshSheetState(form);
    var selected = form.querySelectorAll('input[name="students[]"]:checked').length;
    var used = form.querySelectorAll("[data-id-card-slot].is_used").length;
    var capacity = form.querySelectorAll("[data-id-card-slot]").length;
    return (selected > 0 && selected <= Math.max(0, capacity - used));
}

(function () {
    var block = document.querySelector(".school_id_card_block");
    if (!block)
        return;
    var sheetForm = block.querySelector(".school_id_card_sheet_form");
    if (sheetForm)
        schoolIdCardRefreshSheetState(sheetForm);
    block.addEventListener("dabsic-editor-saved", function () {
        schoolIdCardRefreshPreview(<?=(int)$school["id"]; ?>);
    });
})();
</script>
