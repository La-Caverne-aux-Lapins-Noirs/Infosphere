<script>
function school_staff_inclusion_charter_generate(userId)
{
    var form = document.getElementById('school_staff_inclusion_charter_form');
    if (!form || !userId)
        return false;
    form.querySelector('[name="context_bindings"]').value = JSON.stringify({
        Student: String(userId),
        School: <?=json_encode($school["codename"], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>
    });
    form.submit();
    return false;
}
</script>
