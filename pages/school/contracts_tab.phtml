<script>
function school_contract_chain(form)
{
    var chain = [
        {type: 'school', prefix: 'School', id: '<?=addslashes($school["codename"]); ?>'}
    ];
    var director = form.querySelector('[name="director_id"]').value;
    if (director != '')
        chain.push({type: 'user', prefix: 'SignatureSources.Director', id: director, signatory: 'Director'});
    return chain;
}

function school_contract_open_form(form, hash)
{
    var nonce = '';
    if (window.crypto && window.crypto.getRandomValues) {
        var bytes = new Uint8Array(8);
        window.crypto.getRandomValues(bytes);
        nonce = Array.prototype.map.call(bytes, function (v) { return v.toString(16).padStart(2, '0'); }).join('');
    } else
        nonce = Date.now().toString(16).padStart(16, '0').slice(-16);
    var output = 'school-contract:<?=$school["id"]; ?>:' + hash + ':' + nonce;
    var url = 'index.php?p=DabsicFormMenu' +
        '&file=' + encodeURIComponent(form.querySelector('[name="form_file"]').value) +
        '&output=' + encodeURIComponent(output) +
        '&mode=docbuilder' +
        '&chain=' + encodeURIComponent(JSON.stringify(school_contract_chain(form)));
    window.open(url, '_blank', 'noopener');
}

function school_contract_prepare(form)
{
    var chain = school_contract_chain(form);
    form.querySelector('[name="chain"]').value = JSON.stringify(chain);
    form.querySelector('[name="director_id"]').disabled = true;
    setTimeout(function() { form.querySelector('[name="director_id"]').disabled = false; }, 0);
    return true;
}
</script>
