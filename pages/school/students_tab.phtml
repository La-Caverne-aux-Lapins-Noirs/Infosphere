<script>
var schoolStudentFollowupLastTrigger = null;

function school_student_followup_open(studentId, studentCodename)
{
    var overlay = document.getElementById('school_student_followup_overlay');
    var form = document.getElementById('school_student_followup_form');
    schoolStudentFollowupLastTrigger = document.activeElement;

    form.querySelector('[name="save_user_document"]').value = studentId;
    form.setAttribute('data-student-id', studentId);
    form.querySelector('[data-followup-type]').selectedIndex = 0;
    form.querySelector('[data-followup-period]').value = '';
    form.querySelector('[data-followup-deadline]').value = '';
    form.querySelector('[data-followup-facts]').value = '';
    form.querySelector('[data-followup-previous]').value = '';
    form.querySelector('[data-followup-meeting]').value = '';
    school_student_followup_apply_type(form);

    var director = form.querySelector('[data-followup-director]');
    director.value = director.getAttribute('data-default-director') || '';
    document.getElementById('school_student_followup_identity').textContent = studentCodename;

    overlay.hidden = false;
    document.body.classList.add('school_student_document_open');
    window.setTimeout(function () {
        form.querySelector('[data-followup-type]').focus();
    }, 0);
}

function school_student_followup_close()
{
    var overlay = document.getElementById('school_student_followup_overlay');
    if (overlay.hidden)
        return ;
    overlay.hidden = true;
    document.body.classList.remove('school_student_document_open');
    if (schoolStudentFollowupLastTrigger && typeof schoolStudentFollowupLastTrigger.focus == 'function')
        schoolStudentFollowupLastTrigger.focus();
    schoolStudentFollowupLastTrigger = null;
}

function school_student_followup_apply_type(form)
{
    var select = form.querySelector('[data-followup-type]');
    var option = select && select.options.length ? select.options[select.selectedIndex] : null;
    if (!option)
        return ;
    form.querySelector('[data-followup-support]').value = option.getAttribute('data-support') || '';
}

function school_student_followup_set_field(form, name, value)
{
    var target = form.querySelector('[data-followup-field="' + name + '"]');
    if (target)
        target.value = 'FollowUp.' + name + '=' + value;
}

function school_student_followup_prepare(form)
{
    var student = form.getAttribute('data-student-id') || '';
    var director = form.querySelector('[data-followup-director]').value;
    var type = form.querySelector('[data-followup-type]');
    var option = type && type.options.length ? type.options[type.selectedIndex] : null;
    var facts = form.querySelector('[data-followup-facts]').value.trim();
    var support = form.querySelector('[data-followup-support]').value.trim();
    if (student == '' || director == '' || !option || type.value == '' || facts == '' || support == '')
        return false;
    form.querySelector('[name="docref_student_followup"]').value = type.value;

    form.querySelector('[name="context_bindings"]').value = JSON.stringify({
        Student: student,
        School: <?=json_encode($school["codename"], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>,
        Director: director
    });

    school_student_followup_set_field(form, 'Reason', option.getAttribute('data-reason') || option.textContent.trim());
    school_student_followup_set_field(form, 'Period', form.querySelector('[data-followup-period]').value.trim());
    school_student_followup_set_field(form, 'Facts', facts);
    school_student_followup_set_field(form, 'PreviousContacts', form.querySelector('[data-followup-previous]').value.trim());
    school_student_followup_set_field(form, 'ResponseDeadline', form.querySelector('[data-followup-deadline]').value.trim());
    school_student_followup_set_field(form, 'SupportProposal', support);
    school_student_followup_set_field(form, 'MeetingProposal', form.querySelector('[data-followup-meeting]').value.trim());

    window.setTimeout(school_student_followup_close, 0);
    return true;
}

(function () {
    var overlay = document.getElementById('school_student_followup_overlay');
    overlay.addEventListener('click', function (event) {
        if (event.target === overlay)
            school_student_followup_close();
    });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !overlay.hidden)
            school_student_followup_close();
    });
})();
</script>
