<script>
var schoolStudentDocumentLastTrigger = null;

function school_student_document_open(studentId, studentCodename, defaultYear)
{
    var overlay = document.getElementById('school_student_document_overlay');
    var form = document.getElementById('school_student_document_form');
    schoolStudentDocumentLastTrigger = document.activeElement;

    form.querySelector('[data-document-student-id]').value = studentId;
    form.querySelector('[data-document-year]').value = String(defaultYear || 1);
    form.querySelector('[data-document-reference]').value = '';

    var director = form.querySelector('[data-document-director]');
    director.value = director.getAttribute('data-default-director') || '';
    document.getElementById('school_student_document_identity').textContent = studentCodename;

    overlay.hidden = false;
    document.body.classList.add('school_student_document_open');
    window.setTimeout(function () {
        form.querySelector('[data-document-reference]').focus();
    }, 0);
}

function school_student_document_close()
{
    var overlay = document.getElementById('school_student_document_overlay');
    if (overlay.hidden)
        return ;
    overlay.hidden = true;
    document.body.classList.remove('school_student_document_open');
    if (schoolStudentDocumentLastTrigger && typeof schoolStudentDocumentLastTrigger.focus == 'function')
        schoolStudentDocumentLastTrigger.focus();
    schoolStudentDocumentLastTrigger = null;
}

function school_student_document_prepare(form)
{
    var reference = form.querySelector('[data-document-reference]').value;
    var student = form.querySelector('[data-document-student-id]').value;
    var year = parseInt(form.querySelector('[data-document-year]').value, 10);
    var director = form.querySelector('[data-document-director]').value;

    if (reference == '' || student == '' || !Number.isInteger(year) || year < 1 || year > 5)
        return false;

    form.querySelector('[name="docref_student_document"]').value = reference;

    // Les champs d'année sont ajoutés APRES les contextes élève. mergeconf
    // applique la dernière valeur rencontrée : ils remplacent donc bien les
    // valeurs éventuellement présentes dans identity.dab.
    var chain = [
        {type: 'school', prefix: 'School', id: <?=json_encode($school["codename"], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>},
        {type: 'student', prefix: 'Student', id: student},
        {type: 'student', prefix: 'SignatureSources.Student', id: student, signatory: 'Student'}
    ];
    if (director != '')
        chain.push({type: 'user', prefix: 'SignatureSources.Director', id: director, signatory: 'Director'});
    chain.push(
        {type: 'field', key: 'Student.ChosenClass', value: 'EF' + year},
        {type: 'field', key: 'Student.CurrentYear', value: String(year)},
        {type: 'field', key: 'SignatureSources.Student.ChosenClass', value: 'EF' + year},
        {type: 'field', key: 'SignatureSources.Student.CurrentYear', value: String(year)}
    );
    form.querySelector('[name="chain"]').value = JSON.stringify(chain);

    window.setTimeout(school_student_document_close, 0);
    return true;
}

(function () {
    var overlay = document.getElementById('school_student_document_overlay');
    overlay.addEventListener('click', function (event) {
        if (event.target === overlay)
            school_student_document_close();
    });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !overlay.hidden)
            school_student_document_close();
    });
})();
</script>
