<script>
var schoolStudentDocumentLastTrigger = null;

function school_student_document_open(studentId, studentCodename, defaultYear)
{
    var overlay = document.getElementById('school_student_document_overlay');
    var form = document.getElementById('school_student_document_form');
    schoolStudentDocumentLastTrigger = document.activeElement;

    form.querySelector('[data-document-student-id]').value = studentId;
    form.querySelector('[data-document-year]').value = String(defaultYear || 1);
    form.querySelector('[data-document-reference]').value = '';

    var director = form.querySelector('[data-document-director]');
    director.value = director.getAttribute('data-default-director') || '';
    document.getElementById('school_student_document_identity').textContent = studentCodename;

    overlay.hidden = false;
    document.body.classList.add('school_student_document_open');
    window.setTimeout(function () {
        form.querySelector('[data-document-reference]').focus();
    }, 0);
}

function school_student_document_close()
{
    var overlay = document.getElementById('school_student_document_overlay');
    if (overlay.hidden)
        return ;
    overlay.hidden = true;
    document.body.classList.remove('school_student_document_open');
    if (schoolStudentDocumentLastTrigger && typeof schoolStudentDocumentLastTrigger.focus == 'function')
        schoolStudentDocumentLastTrigger.focus();
    schoolStudentDocumentLastTrigger = null;
}

function school_student_document_prepare(form)
{
    var reference = form.querySelector('[data-document-reference]').value;
    var student = form.querySelector('[data-document-student-id]').value;
    var year = parseInt(form.querySelector('[data-document-year]').value, 10);
    var director = form.querySelector('[data-document-director]').value;

    if (reference == '' || student == '' || !Number.isInteger(year) || year < 1 || year > 5)
        return false;

    form.querySelector('[name="docref_student_document"]').value = reference;

    var bindings = {
        School: <?=json_encode($school["codename"], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>,
        Student: student
    };
    if (director != '')
        bindings.Director = director;
    form.querySelector('[name="context_bindings"]').value = JSON.stringify(bindings);

    // Explicit year overrides remain mergeconf fields.  Student is also the
    // signatory source declared by the model, so no duplicate identity scope is needed.
    form.querySelector('[data-document-class-field]').value = 'Student.ChosenClass=EF' + year;
    form.querySelector('[data-document-year-field]').value = 'Student.CurrentYear=' + year;

    window.setTimeout(school_student_document_close, 0);
    return true;
}

function school_student_document_start_workflow(form)
{
    var select = form.querySelector('[data-document-reference]');
    var option = select.options[select.selectedIndex];
    var student = form.querySelector('[data-document-student-id]').value;
    var year = parseInt(form.querySelector('[data-document-year]').value, 10);
    var director = form.querySelector('[data-document-director]').value;
    if (!option || option.value == '' || student == '' || !Number.isInteger(year) || year < 1 || year > 5)
        return false;
    if (option.getAttribute('data-workflow') != '1')
    {
        window.alert('Ce modèle ne définit aucun rôle de contribution et ne peut être utilisé qu\'en génération directe.');
        return false;
    }

    var bindings = {
        School: <?=json_encode($school["codename"], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>,
        Student: student
    };
    if (director != '')
        bindings.Director = director;

    var workflow = document.getElementById('school_student_document_workflow_form');
    workflow.action = '/api/user/' + encodeURIComponent(student) + '/document_workspace';
    workflow.querySelector('[name="document_file"]').value = option.getAttribute('data-editor-path') || '';
    workflow.querySelector('[name="model_hash"]').value = option.getAttribute('data-model-hash') || '';
    workflow.querySelector('[name="document_label"]').value = option.getAttribute('data-document-label') || option.textContent.trim();
    workflow.querySelector('[name="target_year"]').value = String(year);
    workflow.querySelector('[name="context_bindings"]').value = JSON.stringify(bindings);
    return silent_submitf(workflow, {
        after_success: function (result, message, content) {
            school_student_document_close();
            if (content)
                window.location.href = content;
        }
    });
}

(function () {
    var overlay = document.getElementById('school_student_document_overlay');
    overlay.addEventListener('click', function (event) {
        if (event.target === overlay)
            school_student_document_close();
    });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !overlay.hidden)
            school_student_document_close();
    });
})();
</script>
