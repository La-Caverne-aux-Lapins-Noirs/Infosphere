if (!function_exists("school_student_contract_default_year"))
{
    function school_student_contract_default_year($id_student, $id_school)
    {
        $id_student = (int)$id_student;
        $id_school = (int)$id_school;
        $today = db_form_date(now());
        $cycle = db_select_one("
            cycle.cycle as cycle_level
            FROM user_cycle
            LEFT JOIN cycle ON cycle.id = user_cycle.id_cycle
            LEFT JOIN school_cycle
              ON school_cycle.id_cycle = cycle.id
             AND school_cycle.id_school = $id_school
            WHERE user_cycle.id_user = $id_student
              AND cycle.id IS NOT NULL
              AND cycle.deleted IS NULL
              AND school_cycle.id IS NOT NULL
              AND (cycle.first_day IS NULL OR cycle.first_day <= '$today')
            ORDER BY
              CASE WHEN cycle.first_day IS NULL THEN 1 ELSE 0 END ASC,
              cycle.first_day DESC,
              cycle.cycle DESC,
              cycle.id DESC
        ");
        if ($cycle == NULL || !isset($cycle["cycle_level"]))
            return (1);
        return (max(1, min(5, (int)floor(((int)$cycle["cycle_level"]) / 4) + 1)));
    }
}

