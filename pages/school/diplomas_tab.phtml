<script>
function schoolDiplomaToggleSecret(id)
{
    var input = document.getElementById("school-diploma-secret-" + id);
    if (!input)
        return;
    input.type = input.type === "password" ? "text" : "password";
}

function schoolDiplomaGenerateSecret(id)
{
    var input = document.getElementById("school-diploma-secret-" + id);
    if (!input || !window.crypto || !window.crypto.getRandomValues)
        return;
    if (!confirm(<?=json_encode($Dictionnary["DiplomaGenerateSecretConfirm"] ?? "Remplacer le secret actuel ? Les diplômes déjà émis ne pourront plus être reproduits exactement avec ce nouveau secret.", JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>))
        return;
    var bytes = new Uint8Array(32);
    window.crypto.getRandomValues(bytes);
    input.value = Array.prototype.map.call(bytes, function (byte) {
        return byte.toString(16).padStart(2, "0");
    }).join("");
    input.type = "text";
}

function schoolDiplomaSelectFontEverywhere(source)
{
    var form = source && source.form;
    if (!form || !source.value)
        return;
    form.querySelectorAll("[data-diploma-font-slot]").forEach(function (select) {
        for (var i = 0; i < select.options.length; ++i)
            if (select.options[i].value === source.value)
            {
                select.value = source.value;
                break;
            }
    });
}

function schoolDiplomaPreviewMarkStale(id)
{
    var image = document.getElementById("school-diploma-preview-" + id);
    var state = document.getElementById("school-diploma-preview-state-" + id);
    if (!image || !state || image.hidden)
        return;
    state.dataset.previewStale = "1";
    state.textContent = <?=json_encode($Dictionnary["DiplomaPreviewStale"] ?? "Configuration modifiée : l'aperçu précédent est conservé jusqu'à la prochaine actualisation.", JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
}

function schoolDiplomaRefreshPreview(form, id)
{
    if (!form)
        return false;
    var button = document.getElementById("school-diploma-preview-refresh-" + id);
    var image = document.getElementById("school-diploma-preview-" + id);
    var state = document.getElementById("school-diploma-preview-state-" + id);
    if (button)
        button.disabled = true;

    return silent_submitf(form, {
        after_success: function () {
            if (image)
            {
                image.src = "/api/school/" + id + "/diploma_preview?rev=" + Date.now();
                image.hidden = false;
            }
            if (state)
            {
                state.dataset.previewStale = "0";
                state.textContent = <?=json_encode($Dictionnary["DiplomaPreviewHelp"] ?? "Le dernier aperçu généré est conservé. GenDiplome n'est relancé que lorsque vous cliquez sur Actualiser.", JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
            }
        },
        after_complete: function (success) {
            if (button)
                button.disabled = false;
            if (!success && state)
                state.textContent = <?=json_encode($Dictionnary["DiplomaPreviewFailed"] ?? "La génération de l'aperçu a échoué ; l'aperçu précédent est conservé.", JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
        }
    });
}

(function () {
    var block = document.querySelector(".school_diploma_block");
    if (!block)
        return;
    block.addEventListener("dabsic-editor-saved", function () {
        // Saving Dabsic must never launch GenDiplome. Keep the last rendered
        // image and merely tell the director that it no longer reflects the
        // current configuration.
        schoolDiplomaPreviewMarkStale(<?=(int)$school["id"]; ?>);
    });
})();
</script>
