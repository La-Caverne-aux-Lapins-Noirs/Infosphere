        <?php if ($can_generate_cycle_result_letters) { ?>
            <script>
            (function () {
                var cells = Array.prototype.slice.call(document.querySelectorAll(
                    '.cycle_result_letter_cell[data-cycle-result-user]'
                ));

                function failCell(cell, message) {
                    var status = cell.querySelector('.cycle_result_letter_status');
                    if (status) {
                        status.textContent = 'Erreur';
                        status.title = message || 'Impossible de calculer le courrier de résultat';
                    }
                }

                function fillCell(cell, packet) {
                    var status = cell.querySelector('.cycle_result_letter_status');
                    var form = cell.querySelector('form');
                    if (!packet.available || !form) {
                        if (status)
                            status.textContent = '—';
                        return;
                    }

                    var kind = String(packet.kind || '');
                    var flames = parseInt(packet.flames, 10);
                    if (!Number.isFinite(flames))
                        flames = 0;
                    var label = String(packet.label || 'Courrier');
                    var reference = String(packet.reference || '');
                    if (!reference) {
                        failCell(cell, 'Source de document introuvable');
                        return;
                    }

                    form.querySelector('[name="docref_cycle_result"]').value = reference;
                    form.querySelector('[name="print_label"]').value = label;
                    form.querySelector('[name="print_source_key"]').value =
                        'cycle-result:<?=(int)$cycle["id"]; ?>:' +
                        cell.getAttribute('data-cycle-result-user') + ':' + kind;
                    form.querySelector('[data-cycle-result-field="flames"]').value =
                        'Result.Flames=' + flames;
                    form.querySelector('[data-cycle-result-field="range"]').value =
                        'Result.RangeLabel=' + label;

                    var reboot = form.querySelector('.cycle_result_letter_reboot');
                    if (reboot)
                        reboot.style.display =
                            (kind === 'support' || kind === 'encouragement') ? '' : 'none';

                    var generate = form.querySelector('.cycle_result_letter_generate');
                    if (generate) {
                        generate.value = label + ' (' + flames + ')';
                        generate.disabled = false;
                    }
                    var printButton = form.querySelector('.cycle_result_letter_print');
                    if (printButton)
                        printButton.disabled = false;

                    if (status)
                        status.style.display = 'none';
                    form.style.display = '';
                }

                function loadOne(index) {
                    if (index >= cells.length)
                        return;
                    var cell = cells[index];
                    var body = new URLSearchParams();
                    body.set('student', cell.getAttribute('data-cycle-result-user'));

                    fetch('/api/cycle/<?=(int)$cycle["id"]; ?>/result-letter', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'},
                        body: body.toString()
                    })
                    .then(function (response) {
                        if (!response.ok)
                            throw new Error('HTTP ' + response.status);
                        return response.json();
                    })
                    .then(function (packet) {
                        if (packet.result !== 'ok')
                            throw new Error(packet.msg || 'Erreur API');
                        fillCell(cell, packet);
                    })
                    .catch(function (error) {
                        failCell(cell, error && error.message ? error.message : String(error));
                    })
                    .then(function () {
                        loadOne(index + 1);
                    });
                }

                loadOne(0);
            })();
            </script>
