                    if (($task["task_action"] ?? "") === "sign" && ($meta["slot"] ?? "") != "")
                        $campaign_tasks_by_slot[$meta["slot"]] = $task;
                }
                $campaign_pdf = "/?p=DocumentWorkflowPdf&silent=1&owner=".(int)$campaign_entry["owner_user_id"]."&instance=".rawurlencode($campaign_id);
            ?>
                <tr>
                    <td><strong><?=htmlspecialchars(document_workflow_instance_label($campaign), ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?></strong><br /><small>Créée le <?=htmlspecialchars((string)($campaign["CreatedAt"] ?? "—"), ENT_QUOTES); ?></small></td>
