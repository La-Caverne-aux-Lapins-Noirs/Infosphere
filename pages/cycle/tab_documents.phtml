    <?php if (count($cycle_document_workflows)) { ?>
        <h3>Feuilles individuelles</h3>
        <div class="cycle_document_workflow_table">
        <table>
            <thead><tr><th>Élève</th><th>État</th><th>Signatures</th><th>Créée le</th><th>Actions</th></tr></thead>
            <tbody>
            <?php foreach ($cycle_document_workflows as $entry) {
                $instance = $entry["instance"];
                $student = $entry["student"];
                $instance_id = (string)($instance["Id"] ?? "");
                $status = (string)($instance["Status"] ?? "");
                $pending_slots = [];
                $remindable_slots = [];
                foreach (($instance["Signatures"] ?? []) as $slot => $signature)
                    if (is_array($signature) && !empty($signature["Required"])
                        && ($signature["Status"] ?? "Pending") !== "Signed")
                    {
                        $pending_slots[$slot] = $signature;
                        if (!document_workflow_signature_is_external_campaign($signature))
                            $remindable_slots[$slot] = $signature;
                    }
                $tasks_by_slot = [];
                foreach (($entry["tasks"] ?? []) as $task)
                {
                    $meta = document_task_metadata($task);
                    if (($task["task_action"] ?? "") === "sign" && ($meta["slot"] ?? "") != "")
                        $tasks_by_slot[$meta["slot"]] = $task;
                }
                $pdf = "/?p=DocumentWorkflowPdf&silent=1&owner=".(int)$student["id"]."&instance=".rawurlencode($instance_id);
            ?>
                <tr>
                    <td><a href="index.php?p=ProfileMenu&amp;a=<?=(int)$student["id"]; ?>"><?=htmlspecialchars((string)$student["codename"], ENT_QUOTES); ?></a></td>
                    <td><?=htmlspecialchars($cycle_document_status_labels[$status] ?? $status, ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?><?php if (($instance["ArchiveError"] ?? "") != "") { ?><br /><small><?=htmlspecialchars((string)$instance["ArchiveError"], ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?></small><?php } ?></td>
                    <td>
                        <?=(int)$entry["signature_signed"]; ?>/<?=(int)$entry["signature_total"]; ?>
                        <?php if (count($pending_slots)) { ?><ul class="document_task_list">
                        <?php foreach ($pending_slots as $slot => $signature) {
                            $label = document_workflow_signature_role_label($slot, $signature);
                            $task = $tasks_by_slot[$slot] ?? [];
                            $meta = is_array($task) ? document_task_metadata($task) : [];
                            $assignee = trim((string)($meta["assignee_label"] ?? ""));
                            if (document_workflow_signature_is_external_campaign($signature))
                                $assignee = trim($assignee." (signature portée par la campagne)");
                        ?>
                            <li class="is-pending">⚠ <?=htmlspecialchars($label.($assignee != "" ? " — ".$assignee : ""), ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?></li>
                        <?php } ?></ul><?php } ?>
                    </td>
                    <td><?=htmlspecialchars((string)($instance["CreatedAt"] ?? "—"), ENT_QUOTES); ?></td>
