                                $task = $campaign_tasks_by_slot[$slot] ?? [];
                                $meta = is_array($task) ? document_task_metadata($task) : [];
                                $assignee = trim((string)($meta["assignee_label"] ?? ""));
                                $verb = !empty($signature["InvitedAt"]) ? "Relancer" : "Envoyer";
                            ?>
                                <form method="post" action="/api/doc/0/remind" onsubmit="return cycle_document_remind(this);">
                                    <input type="hidden" name="owner_user_id" value="<?=(int)$campaign_entry["owner_user_id"]; ?>" />
                                    <input type="hidden" name="instance_id" value="<?=htmlspecialchars($campaign_id, ENT_QUOTES); ?>" />
