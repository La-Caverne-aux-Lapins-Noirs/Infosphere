<td class="cycle_list_actions">
    <div class="cycle_list_actions_inner">
        <?php $js = "silent_submit(this);" ?>
        <?php if ($page == "cycle") { ?>
            <form
                class="cycle_list_done_form"
                method="put"
                action="/api/<?=$page; ?>/<?=$content["id"]; ?>"
            >
                <input type="hidden" name="check_done" value="1" />
                <label title="<?=$Dictionnary["CycleDone"]; ?>">
                    <input type="checkbox" name="done" onchange="silent_submit(this);" <?=$content["done"] ? "checked" : ""; ?> />
                    <span>✓</span>
                </label>
            </form>
        <?php } else { ?>
            <form
                class="cycle_list_instantiate_form"
                method="post"
                action="/api/<?=$page; ?>/<?=$content["id"]; ?>/instantiate"
            >
                <input
                    type="date"
                    name="first_week"
                    aria-label="<?=$Dictionnary["FirstWeekDate"]; ?>"
                    title="<?=$Dictionnary["FirstWeekDate"]; ?>"
                />
                <input
                    type="text"
                    name="instance_name"
                    placeholder="<?=$Dictionnary["CodeName"]; ?>"
                    aria-label="<?=$Dictionnary["CodeName"]; ?>"
                />
                <input type="button" onclick="<?=$js; ?>" value="<?=$Dictionnary["Instantiate"]; ?>" />
            </form>
        <?php } ?>

        <form
            class="cycle_list_export_form"
            method="post"
            action="index.php?<?=unrollget(["silent" => 1, "export" => 1]); ?>"
            onsubmit="return cycle_list_export(this);"
            data-cycle-module="<?=$page; ?>"
            data-cycle-id="<?=(int)$content["id"]; ?>"
        >
            <input type="hidden" name="action" value="export_activity" />
            <input type="hidden" name="cycle" value="<?=$content["id"]; ?>" />
            <select name="format" aria-label="<?=$Dictionnary["Export"]; ?>">
                <option value="sketch"><?=$Dictionnary["Sketch"]; ?></option>
                <option value="detailed_sketch"><?=$Dictionnary["DetailedSketch"]; ?></option>
                <option value="syllabus"><?=$Dictionnary["Syllabus"]; ?></option>
                <option value="dabsic"><?=$Dictionnary["ExportDabsic"]; ?></option>
                <option value="timeline"><?=$Dictionnary["ExportTimeline"]; ?></option>
            </select>
            <input type="submit" value="<?=$Dictionnary["Export"]; ?>" />
        </form>

        <?php $js = "window.confirm('".$Dictionnary["ConfirmDeletion"]."') && silent_submit(this, 'cyclelist');" ?>
        <form
            class="cycle_list_delete_form"
            method="delete"
            action="/api/<?=$page; ?>/<?=$content["id"]; ?>"
            onsubmit="return <?=$js; ?>;"
        >
            <input
                type="button"
                onclick="<?=$js; ?>"
                value="&#10007;"
                title="<?=$Dictionnary["Delete"]; ?>"
            />
        </form>
    </div>
</td>
