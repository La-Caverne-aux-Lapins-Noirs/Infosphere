                    />
                    <input
                        type="button"
                        value="<?=$Dictionnary["UncheckAll"]; ?>"
                        onclick="document.querySelectorAll('#<?=$timeline_form_id; ?> input[name=&quot;matter[]&quot;]').forEach(function(n){n.checked=false;});"
