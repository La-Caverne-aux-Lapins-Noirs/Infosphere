                        $matter_label .= " — ".$matter_name;
                    ?>
                    <label>
                        <input type="checkbox" name="matter[]" value="<?=(int)$matter["id"]; ?>" checked />
                        <span><?=htmlspecialchars($matter_label, ENT_QUOTES); ?></span>
                    </label>
                <?php } ?>
            </div>

            <div class="cycle_admin_export_actions">
                <input type="submit" value="<?=$Dictionnary["ExportTimeline"]; ?>" />
