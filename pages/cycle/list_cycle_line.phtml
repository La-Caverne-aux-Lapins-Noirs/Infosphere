<?php
$URL = unrollurl(["a" => $content["id"]]);
$cycle_codename = (string)$content["codename"];
$cycle_name = trim((string)($content["name"] ?? ""));
?>

<td <?=clickable($URL); ?>><?=$content["id"]; ?></td>
<td class="cycle_list_name" <?=clickable($URL); ?>>
    <button
        type="button"
        class="cycle_list_codename"
        title="Copier <?=$cycle_codename; ?>"
        onclick="event.stopPropagation(); cycle_copy_codename(this, <?=htmlspecialchars(json_encode($cycle_codename), ENT_QUOTES); ?>);"
    ><?=htmlspecialchars($cycle_codename); ?></button><?php if ($cycle_name != "" && $cycle_name != $cycle_codename) { ?><span class="cycle_list_name_separator"> — </span><span class="cycle_list_pretty_name"><?=htmlspecialchars($cycle_name); ?></span><?php } ?>
</td>
<td class="cycle_list_credits" <?=clickable($URL); ?>>
    <?=$content["min_credit"]; ?>–<?=$content["max_credit"]; ?> / <?=$content["objective"]; ?>
</td>
<?php if ($content["is_template"] == 0) { ?>
    <td class="cycle_list_date" <?=clickable($URL); ?>><?=datex("d/m/Y", $content["first_day"]); ?></td>
    <td class="cycle_list_date" <?=clickable($URL); ?>><?=datex("d/m/Y", $content["last_day"]); ?></td>
    <td class="cycle_list_template">
        <?php if (($content["id_template"] ?? -1) != -1 && ($content["id_template"] ?? NULL) !== NULL && trim((string)($content["codename_template"] ?? "")) != "") { ?>
            <a
                href="index.php?p=CycleTemplateMenu&amp;a=<?=(int)$content["id_template"]; ?>"
                title="<?=htmlspecialchars((string)$content["codename_template"], ENT_QUOTES); ?>"
            ><?=htmlspecialchars((string)$content["codename_template"]); ?></a>
        <?php } else { ?>
            <span class="cycle_list_empty">—</span>
        <?php } ?>
    </td>
<?php } ?>
<td class="cycle_list_number" <?=clickable($URL); ?>>
    <span class="cycle_list_number_value"><?=$content["cycle"]; ?></span>
    <span class="cycle_list_number_detail">(<?=$Dictionnary["Year"]; ?> <?=floor($content["cycle"] / 4) + 1; ?>, <?=$Dictionnary["Cycle"]; ?> <?=$content["cycle"] % 4 + 1; ?>)</span>
</td>
<?php if ($page == "cycle") { ?>
    <td class="cycle_list_count" <?=clickable($URL); ?>><?=count($content["user"]); ?></td>
<?php } ?>
<td class="cycle_list_count" <?=clickable($URL); ?>><?=count($content["activity"]); ?></td>
<?php if (!am_i_director()) { ?>
    <td class="cycle_list_people">
        <?php foreach ($content["teacher"] as $teacher) { ?>
            <?php $dest = $teacher["codename"][0] != "#" ? "Profile" : "Laboratories"; ?>
            <a href="index.php?p=<?=$dest; ?>Menu&amp;a=<?=$teacher["id"]; ?>">
                <?=$teacher["codename"]; ?>
            </a>
        <?php } ?>
    </td>
<?php } else { ?>
    <?php require ("edit_cycle.phtml"); ?>
<?php } ?>
