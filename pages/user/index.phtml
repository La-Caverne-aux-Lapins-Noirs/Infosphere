<script>
function userListNormalize(value)
{
    value = (value || "").toString().toLocaleLowerCase();
    if (typeof value.normalize === "function")
        value = value.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    return value.trim();
}

function userListSetPhotoOnly(card, enabled)
{
    var avatar = card.querySelector(".user-card-avatar-default");
    var photo = card.querySelector(".user-card-avatar-photo");

    if (avatar)
        avatar.hidden = enabled;
    if (photo)
        photo.hidden = !enabled;
}

function userListApplyFilters()
{
    var search = document.getElementById("searchbar");
    var banned = document.getElementById("user-list-show-banned");
    var photo = document.getElementById("user-list-photo-only");
    var query = userListNormalize(search ? search.value : "");
    var showBanned = banned ? banned.checked : false;
    var photoOnly = photo ? photo.checked : false;

    document.querySelectorAll("#userlist .userdiv").forEach(function(card) {
        var cardSearch = userListNormalize(card.getAttribute("data-user-search") || card.textContent);
        var isBanned = card.getAttribute("data-user-banned") === "1";
        var visible = (!isBanned || showBanned) && (!query || cardSearch.indexOf(query) !== -1);

        card.hidden = !visible;
        userListSetPhotoOnly(card, photoOnly);
    });
}

(function() {
    var list = document.getElementById("userlist");
    userListApplyFilters();
    if (list && window.MutationObserver)
        new MutationObserver(userListApplyFilters).observe(list, {childList: true, subtree: false});
})();
</script>
