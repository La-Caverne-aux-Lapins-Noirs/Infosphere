<?php
global $Configuration;

$user_list_is_banned = $user["deleted"] != NULL || (int)$user["authority"] === BANISHED;
$user_list_search = implode(" ", [
    "#".(int)$user["id"],
    $user["codename"] ?? "",
    $user["nickname"] ?? "",
    $user["first_name"] ?? "",
    $user["family_name"] ?? "",
]);
$user_list_photo = $Configuration->UsersDir().$user["codename"]."/admin/photo.png";
$user_list_photo_src = file_exists($user_list_photo) ? $user_list_photo : "res/no_avatar.png";
?>
<div
    id="<?=$user["codename"]; ?>"
    class="alignable_blocks userdiv"
    data-user-search="<?=htmlspecialchars($user_list_search, ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?>"
    data-user-banned="<?=$user_list_is_banned ? "1" : "0"; ?>"
    <?=$user_list_is_banned ? "hidden" : ""; ?>
    <?php if ($user_list_is_banned) { ?>
        style="opacity: 0.8; background-color: darkgray;"
    <?php } ?>
>
    <h3 class="topleft">
        <a href="<?=profile($user["id"]); ?>">
            #<?=$user["id"]; ?> <?=$user["codename"]; ?>
        </a>
        <span class="smalltext">
            <?php if ($user["id"] != 1) { ?>
                <?=@strlen($user["nickname"]) ? "<br /><i>{$user["nickname"]}</i>" : ""; ?>
                <?php if (strlen($user["first_name"]) || strlen($user["family_name"])) { ?>
                    <br /><?=$user["first_name"]; ?> <?=$user["family_name"]; ?>
                <?php } ?>
            <?php } ?>
            <?php if ($user["authority"] != 0) { ?>
                <br /><i><?=$user["authority"] == BANISHED ? ($Dictionnary["Banished"] ?? "Banni") : $Dictionnary["Administrator"]; ?></i>
            <?php } ?>
            <br />
            <?php if ($user["id"] != 1) { ?>
                <?=$Dictionnary["DateOfRegistration"]; ?>:<br /><?=human_date($user["registration_date"]); ?>
            <?php } ?>
        </span>
    </h3>

    <div class="_200wpx _100hpx topright user-card-picture">
        <div class="right user-card-avatar-default">
            <?php display_avatar($user, 100); ?>
        </div>
        <div class="right user-card-avatar-photo" hidden>
            <a href="<?=profile($user["id"]); ?>">
                <img
                    src="<?=htmlspecialchars($user_list_photo_src, ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?>"
                    alt=""
                    style="width: 100px; height: 100px; border-radius: 10px;"
                />
            </a>
        </div>
    </div>

</div>
