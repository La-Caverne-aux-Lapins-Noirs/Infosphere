<?php
$workflow_status = (string)($tab_data["status"] ?? "");
$workflow_instances = $tab_data["instances"] ?? [];
$workflow_status_labels = [
    "AwaitingSignature" => "En attente de signature",
    "Signed" => "Signatures recueillies",
    "Sealed" => "Scellé",
    "Error" => "Erreur",
    "Completed" => "Terminé",
    "Expired" => "Périmé",
];
$workflow_filtered = [];
foreach ($workflow_instances as $workflow_entry)
    if (($workflow_entry["instance"]["Status"] ?? "") === $workflow_status)
        $workflow_filtered[] = $workflow_entry;
?>
<div class="document_workflow_state">
    <?php if (!count($workflow_filtered)) { ?>
        <div class="document_workflow_empty">Aucun document dans cet état.</div>
    <?php } else { ?>
        <table class="document_workflow_table">
            <thead><tr>
                <th>Document</th><th>Personne</th><th>École</th><th>Créé le</th><th>Signatures</th><th>État</th><th></th>
            </tr></thead>
            <tbody>
            <?php foreach ($workflow_filtered as $workflow_entry) {
                $workflow_instance = $workflow_entry["instance"];
                $workflow_owner = $workflow_entry["owner"];
                $workflow_name = trim((string)($workflow_owner["first_name"] ?? "")." ".(string)($workflow_owner["family_name"] ?? ""));
                if ($workflow_name == "")
                    $workflow_name = (string)($workflow_owner["codename"] ?? ("#".$workflow_entry["owner_user_id"]));
                $workflow_model = document_workflow_instance_label($workflow_instance);
                $workflow_year = (int)($workflow_instance["TargetYear"] ?? 0);
                $workflow_progress = (int)$workflow_entry["signature_signed"]."/".(int)$workflow_entry["signature_total"];
                if ((int)$workflow_entry["signature_total"] == 0)
                    $workflow_progress = "—";
                $workflow_signature_details = [];
                $workflow_tasks_by_slot = [];
                foreach (($workflow_entry["document_tasks"] ?? []) as $workflow_task)
                {
                    if (($workflow_task["task_action"] ?? "") !== "sign" || empty($workflow_task["required"])
                        || ($workflow_task["status"] ?? "") === "expired")
                        continue ;
                    $workflow_task_metadata = document_task_metadata($workflow_task);
                    $workflow_task_slot = (string)($workflow_task_metadata["slot"] ?? "");
                    if ($workflow_task_slot != "")
                        $workflow_tasks_by_slot[$workflow_task_slot] = $workflow_task;
                }
                foreach (($workflow_instance["Signatures"] ?? []) as $workflow_slot => $workflow_signature)
                {
                    if (!is_array($workflow_signature) || empty($workflow_signature["Required"]))
                        continue ;
                    $workflow_role_label = document_workflow_signature_role_label($workflow_slot, $workflow_signature);
                    $workflow_task = $workflow_tasks_by_slot[$workflow_slot] ?? [];
                    $workflow_task_metadata = is_array($workflow_task) ? document_task_metadata($workflow_task) : [];
                    $workflow_assignee_label = trim((string)($workflow_task_metadata["assignee_label"] ?? ""));
                    if ($workflow_assignee_label != "")
                        $workflow_role_label .= " — ".$workflow_assignee_label;
                    if (document_workflow_signature_is_external_campaign($workflow_signature))
                        $workflow_role_label .= " (campagne)";
                    $workflow_signature_details[] = $workflow_role_label.": ".(($workflow_signature["Status"] ?? "") === "Signed" ? "signé" : "en attente");
                }
                $workflow_pending_slots = [];
                foreach (($workflow_instance["Signatures"] ?? []) as $workflow_slot => $workflow_signature)
                    if (is_array($workflow_signature) && !empty($workflow_signature["Required"])
                        && ($workflow_signature["Status"] ?? "Pending") !== "Signed"
                        && !document_workflow_signature_is_external_campaign($workflow_signature))
                        $workflow_pending_slots[$workflow_slot] = $workflow_signature;
                $workflow_schools = document_workflow_instance_school_codenames($workflow_instance);
                $workflow_school = count($workflow_schools) ? implode(", ", $workflow_schools) : "—";
                $workflow_id = (string)($workflow_instance["Id"] ?? "");
                $workflow_pdf = "/?p=DocumentWorkflowPdf&silent=1&owner=".(int)$workflow_entry["owner_user_id"]."&instance=".rawurlencode($workflow_id);
                $workflow_delivery_status = strtolower(trim((string)($workflow_instance["DeliveryMailStatus"] ?? "")));
                $workflow_delivery_accepted_at = trim((string)($workflow_instance["DeliveryAcceptedAt"] ?? ($workflow_instance["DeliveredAt"] ?? "")));
                $workflow_delivery_confirmed_at = trim((string)($workflow_instance["DeliveryConfirmedAt"] ?? ""));
                $workflow_delivery_to = trim((string)($workflow_instance["DeliveryAcceptedTo"] ?? ""));
                if ($workflow_delivery_to == "")
                {
                    $workflow_delivery_addresses = document_workflow_delivery_addresses($workflow_instance);
                    if (count($workflow_delivery_addresses))
                        $workflow_delivery_to = implode(", ", $workflow_delivery_addresses);
                }
                if ($workflow_delivery_status == "" && $workflow_delivery_accepted_at != "")
                    $workflow_delivery_status = "accepted_untracked";
            ?>
                <tr>
                    <td><strong><?=htmlspecialchars($workflow_model, ENT_QUOTES); ?></strong><?php if ($workflow_year > 0) { ?><br /><small>EF<?=$workflow_year; ?></small><?php } ?></td>
                    <td><?=htmlspecialchars($workflow_name, ENT_QUOTES); ?><br /><small><?=htmlspecialchars((string)($workflow_owner["codename"] ?? ""), ENT_QUOTES); ?></small></td>
                    <td><?=htmlspecialchars($workflow_school, ENT_QUOTES); ?></td>
                    <td><?=htmlspecialchars((string)($workflow_instance["CreatedAt"] ?? ""), ENT_QUOTES); ?></td>
                    <td><?=$workflow_progress; ?><?php if (count($workflow_signature_details)) { ?><br /><small><?=htmlspecialchars(implode(" · ", $workflow_signature_details), ENT_QUOTES); ?></small><?php } ?></td>
                    <td><span class="document_workflow_badge document_workflow_<?=htmlspecialchars(strtolower($workflow_status), ENT_QUOTES); ?>"><?=htmlspecialchars($workflow_status_labels[$workflow_status] ?? $workflow_status, ENT_QUOTES); ?></span>
                        <?php if ($workflow_status === "Expired" && !empty($workflow_instance["ExpiredAt"])) { ?><br /><small>Périmé le <?=htmlspecialchars((string)$workflow_instance["ExpiredAt"], ENT_QUOTES); ?><?php if (($workflow_instance["PreviousStatus"] ?? "") != "") { ?> · ancien état : <?=htmlspecialchars((string)$workflow_instance["PreviousStatus"], ENT_QUOTES); ?><?php } ?></small><?php } ?>
                        <?php if (($workflow_instance["Error"] ?? "") != "") { ?><br /><small><?=htmlspecialchars((string)$workflow_instance["Error"], ENT_QUOTES); ?></small><?php } ?>
                        <?php if (($workflow_instance["SealError"] ?? "") != "") { ?><br /><small><?=htmlspecialchars((string)$workflow_instance["SealError"], ENT_QUOTES); ?></small><?php } ?>
                        <?php if ($workflow_status === "Completed" && $workflow_delivery_status === "delivered") { ?><br /><small>Remis au serveur du destinataire<?= $workflow_delivery_to != "" ? " (".htmlspecialchars($workflow_delivery_to, ENT_QUOTES).")" : ""; ?><?= $workflow_delivery_confirmed_at != "" ? " le ".htmlspecialchars($workflow_delivery_confirmed_at, ENT_QUOTES) : ""; ?></small><?php } ?>
                        <?php if ($workflow_status === "Completed" && $workflow_delivery_status === "accepted") { ?><br /><small>Accepté par le service mail<?= $workflow_delivery_to != "" ? " pour ".htmlspecialchars($workflow_delivery_to, ENT_QUOTES) : ""; ?><?= $workflow_delivery_accepted_at != "" ? " le ".htmlspecialchars($workflow_delivery_accepted_at, ENT_QUOTES) : ""; ?> — livraison en attente</small><?php } ?>
                        <?php if ($workflow_status === "Completed" && $workflow_delivery_status === "accepted_untracked") { ?><br /><small>Accepté par le service mail<?= $workflow_delivery_to != "" ? " pour ".htmlspecialchars($workflow_delivery_to, ENT_QUOTES) : ""; ?><?= $workflow_delivery_accepted_at != "" ? " le ".htmlspecialchars($workflow_delivery_accepted_at, ENT_QUOTES) : ""; ?> — ancien envoi non traçable</small><?php } ?>
                        <?php if ($workflow_status === "Completed" && $workflow_delivery_status === "failed") { ?><br /><small>Échec de remise<?= $workflow_delivery_to != "" ? " vers ".htmlspecialchars($workflow_delivery_to, ENT_QUOTES) : ""; ?><?= trim((string)($workflow_instance["DeliveryMailError"] ?? "")) != "" ? " : ".htmlspecialchars((string)$workflow_instance["DeliveryMailError"], ENT_QUOTES) : ""; ?></small><?php } ?>
                        <?php if (($workflow_instance["DeliveryError"] ?? "") != "" && $workflow_delivery_status !== "failed") { ?><br /><small><?=htmlspecialchars((string)$workflow_instance["DeliveryError"], ENT_QUOTES); ?></small><?php } ?>
                    </td>
                    <td class="document_workflow_actions">
                        <a href="<?=htmlspecialchars($workflow_pdf, ENT_QUOTES); ?>" target="_blank" rel="noopener">Voir le PDF</a>
                        <?php if ($workflow_status === "AwaitingSignature" && count($workflow_pending_slots)) { ?>
                            <form method="post" action="/api/doc/0/remind" onsubmit="return document_workflow_remind(this);">
                                <input type="hidden" name="owner_user_id" value="<?=(int)$workflow_entry["owner_user_id"]; ?>" />
                                <input type="hidden" name="instance_id" value="<?=htmlspecialchars($workflow_id, ENT_QUOTES); ?>" />
                                <input type="button" value="Relancer tous les manquants" onclick="return document_workflow_remind(this.form);" />
                            </form>
                            <?php foreach ($workflow_pending_slots as $workflow_slot => $workflow_signature) {
                                $workflow_role_label = document_workflow_signature_role_label($workflow_slot, $workflow_signature);
                                $workflow_task = $workflow_tasks_by_slot[$workflow_slot] ?? [];
                                $workflow_meta = is_array($workflow_task) ? document_task_metadata($workflow_task) : [];
                                $workflow_assignee = trim((string)($workflow_meta["assignee_label"] ?? ""));
                                $workflow_button_label = !empty($workflow_signature["InvitedAt"]) ? "Relancer" : "Envoyer";
                            ?>
                                <form method="post" action="/api/doc/0/remind" onsubmit="return document_workflow_remind(this);">
                                    <input type="hidden" name="owner_user_id" value="<?=(int)$workflow_entry["owner_user_id"]; ?>" />
                                    <input type="hidden" name="instance_id" value="<?=htmlspecialchars($workflow_id, ENT_QUOTES); ?>" />
                                    <input type="hidden" name="slot" value="<?=htmlspecialchars($workflow_slot, ENT_QUOTES); ?>" />
                                    <input type="button" value="<?=htmlspecialchars($workflow_button_label." : ".$workflow_role_label.($workflow_assignee != "" ? " — ".$workflow_assignee : ""), ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?>" onclick="return document_workflow_remind(this.form);" />
                                </form>
                            <?php } ?>
                        <?php } ?>
                        <?php if ($workflow_status !== "Expired") { ?>
                            <form method="post" action="/api/doc/0/expire" onsubmit="return document_workflow_expire(this);">
                                <input type="hidden" name="kind" value="instance" />
                                <input type="hidden" name="owner_user_id" value="<?=(int)$workflow_entry["owner_user_id"]; ?>" />
                                <input type="hidden" name="instance_id" value="<?=htmlspecialchars($workflow_id, ENT_QUOTES); ?>" />
                                <input type="button" value="<?=htmlspecialchars($Dictionnary["DocumentExpireRequest"] ?? "Faire périmer", ENT_QUOTES); ?>" onclick="return document_workflow_expire(this.form);" />
                            </form>
                        <?php } ?>
                    </td>
                </tr>
            <?php } ?>
            </tbody>
        </table>
    <?php } ?>
</div>
