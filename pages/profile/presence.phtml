<?php
require_once (__DIR__."/../../tools/student_log.php");
require_once (__DIR__."/../../tools/halfday_presence.php");
$start = $_GET["s"];
$end = $_GET["e"];
$_GET["lm"] = "m";

$halfday_start = remove_hour($start);
$halfday_end = remove_hour($end);
$halfday_days = max(1, (int)(($halfday_end - $halfday_start) / (24 * 60 * 60)) + 1);
$halfday_presence = halfday_presence_build([$user->id], $halfday_start, $halfday_days);
$halfday_presence = try_get($halfday_presence, $user->id, []);

$start = db_form_date($start, true);
$end = db_form_date($end, true);

$query = db_select_all("
  declaration_date, present, begin_date, session.id_activity, team.id_session
  FROM team
  LEFT JOIN session ON session.id = team.id_session AND session.id_activity != -1 AND session.deleted IS NULL
  LEFT JOIN user_team ON team.id = user_team.id_team
  WHERE user_team.id_user = {$user->id}
  AND session.begin_date >= '$start' AND session.begin_date <= '$end'
");

$_GET["d"] = [];
$_GET["d"]["presence"] = [];
$_GET["d"]["late"] = [];
$_GET["d"]["mispresence"] = [];
$_GET["d"]["halfday_am"] = [];
$_GET["d"]["halfday_pm"] = [];

foreach ($query as $p)
{
    if (!strlen(@$p["begin_date"]))
	continue ;
    $d = (int)(date_to_timestamp($p["begin_date"]) / 60 / 60 / 24);
    if ($p["present"] == 1)
    {
	if (!isset($_GET["d"]["presence"][$d]))
	    $_GET["d"]["presence"][$d] = 0;
	$_GET["d"]["presence"][$d] += 1;
    }
    else if ($p["present"] == -1)
    {
	if (!isset($_GET["d"]["late"][$d]))
	    $_GET["d"]["late"][$d] = 0;
	$_GET["d"]["late"][$d] += 1;
    }
    else if ($p["present"] == -2)
    {
	if (!isset($_GET["d"]["mispresence"][$d]))
	    $_GET["d"]["mispresence"][$d] = 0;
	$_GET["d"]["mispresence"][$d] += 1;
    }
}


$halfday_status_value = [
    "present" => 1,
    "absent" => -1,
    "activity_absent" => -2,
    "pending" => 0,
    "future" => 0,
    "unknown" => 0,
];
for ($i = 0; $i < $halfday_days; ++$i)
{
    $day = $halfday_start + $i * 24 * 60 * 60;
    $day_key = (int)($day / (24 * 60 * 60));
    $periods = try_get($halfday_presence, $day_key, []);
    foreach ([0 => "halfday_am", 1 => "halfday_pm"] as $period => $key)
    {
        $h = try_get($periods, $period, ["status" => "future"]);
        $_GET["d"][$key][$day_key] = try_get($halfday_status_value, $h["status"], 0);
    }
}

$_GET["d"] = json_encode($_GET["d"], JSON_UNESCAPED_SLASHES);
$_GET["d"] = base64_encode($_GET["d"]);
$params = [];
foreach ($_GET as $gk => $gv)
    $params[] = "$gk=$gv";
$params = implode("&amp;", $params);
?>
<div class="statsin" style="background-image: url(/tools/profile_stats.php?<?=$params; ?>);"></div>
