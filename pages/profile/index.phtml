	$_GET["w"] = 960;
	$_GET["h"] = 400;
	// tools/profile_stats.php utilise le jour de fin comme borne journalière exclusive.
	// On vise donc demain pour que la journée en cours soit toujours dessinée,
	// y compris le matin. Avec +12h, les logs du jour n'apparaissaient
	// qu'après le milieu de journée.
	$_GET["e"] = now() + 24 * 60 * 60;
	$_GET["s"] = now() - 14 * 24 * 60 * 60;
	$profile_stats_custom_period = false;
	if (isset($_GET["profile_stats_start"], $_GET["profile_stats_end"]))
	{
	    $profile_stats_parse_date = function ($value)
	    {
		if (!is_string($value) || !preg_match('/^\d{4}-\d{2}-\d{2}$/D', $value))
		    return (NULL);
		$date = DateTimeImmutable::createFromFormat('!Y-m-d', $value, new DateTimeZone('UTC'));
		return ($date !== false && $date->format('Y-m-d') === $value ? $date->getTimestamp() : NULL);
	    };
	    $profile_stats_from = $profile_stats_parse_date($_GET["profile_stats_start"]);
	    $profile_stats_to = $profile_stats_parse_date($_GET["profile_stats_end"]);
	    if ($profile_stats_from !== NULL && $profile_stats_to !== NULL
		&& $profile_stats_to >= $profile_stats_from
		&& $profile_stats_to - $profile_stats_from < 730 * 86400)
	    {
		$_GET["s"] = $profile_stats_from;
		$_GET["e"] = $profile_stats_to + 86400;
		$profile_stats_custom_period = true;
	    }
	}
