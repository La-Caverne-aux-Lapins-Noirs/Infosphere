// La composition technique d'un trimestre est une information interne :
// elle est visible par les membres non étudiants d'une école commune avec
// l'utilisateur consulté (et, naturellement, par l'administration globale).
if (is_admin())
{
    $profile_can_view_cycle_composition = true;
}
else if (isset($User["id"]) && (int)$User["id"] > 0)
{
    $viewer_id = (int)$User["id"];
    $profile_user_id = (int)$user->id;
    $student_authority = user_school_student_authority_sql();
    $profile_can_view_cycle_composition = db_select_one("
        viewer_school.id as id
        FROM user_school as viewer_school
        INNER JOIN user_school as profile_school
          ON profile_school.id_school = viewer_school.id_school
        INNER JOIN school
          ON school.id = viewer_school.id_school
        WHERE viewer_school.id_user = $viewer_id
          AND profile_school.id_user = $profile_user_id
          AND viewer_school.authority <> $student_authority
          AND school.deleted IS NULL
    ") !== NULL;
}

if ($profile_can_view_cycle_composition)
{
    $profile_cycle_ids = [];
    foreach ($user->sublayer as $profile_cycle)
        if ((int)$profile_cycle->id > 0)
            $profile_cycle_ids[(int)$profile_cycle->id] = (int)$profile_cycle->id;

    if (count($profile_cycle_ids))
    {
        $profile_cycle_rows = db_select_all("
            cycle.id as id,
            COALESCE(
                NULLIF(template_cycle.{$Language}_name, ''),
                NULLIF(template_cycle.codename, ''),
                NULLIF(cycle.{$Language}_name, ''),
                cycle.codename
            ) as composition_name
            FROM cycle
            LEFT JOIN cycle as template_cycle
              ON template_cycle.id = cycle.id_template
             AND template_cycle.deleted IS NULL
            WHERE cycle.id IN (".implode(",", $profile_cycle_ids).")
        ");
        foreach ($profile_cycle_rows as $profile_cycle_row)
            $profile_cycle_composition[(int)$profile_cycle_row["id"]] =
                trim((string)$profile_cycle_row["composition_name"]);
    }
}

