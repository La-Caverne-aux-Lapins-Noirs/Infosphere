<?php
$id_profile_user = (int)$user->id;
// Relire la ligne user directement : le FullProfile peut avoir été construit
// avant la dernière validation du formulaire administratif. On veut ici les
// valeurs persistées les plus récentes, notamment administrative_data.
$profile_user_data = db_select_one("* FROM user WHERE id = $id_profile_user AND authority != -1");
$profile_status = $profile_user_data["profile_status"] ?? "";
$is_student_profile = db_select_one("
    user.id
    FROM user
    LEFT JOIN user_school
      ON user_school.id_user = user.id
     AND user_school.authority = 'STUDENT'
    LEFT JOIN user_cycle
      ON user_cycle.id_user = user.id
    WHERE user.id = $id_profile_user
      AND (user_school.id IS NOT NULL OR user_cycle.id IS NOT NULL)
") != NULL;
$is_relation_administrative_profile = user_relation_is_administrative_contact($id_profile_user);
$is_administrative_profile = $is_student_profile || $profile_status == "prospect" || $is_relation_administrative_profile;
$can_edit_administrative = $can_manage_administrative_profile;
$can_view_administrative = $is_administrative_profile
    && (is_me($user->id) || $can_edit_identity || $can_edit_administrative);
$can_send_administrative_form = can_send_user_administrative_form($id_profile_user);
if ($can_view_administrative)
{
    $administrative_user = array_merge((array)$user, $profile_user_data ?: []);
    // get_full_profile() expose ses champs via l'objet ; suivant son implémentation,
    // le cast en tableau ne garantit pas que l'id virtuel soit présent.
    $administrative_user["id"] = $id_profile_user;
    if ($is_relation_administrative_profile && function_exists("user_identity_relation_administrative_fields"))
        $administrative_fields = user_identity_relation_administrative_fields();
    else
        $administrative_fields = user_identity_contract_administrative_fields($administrative_user);
    if ($is_relation_administrative_profile)
        // Pour un responsable, ce bloc représente strictement le complément
        // administrative_data de user. Ne pas le reconstruire depuis les champs
        // d'identité : cela masque les données réellement persistées.
        $administrative = user_identity_administrative_data($administrative_user);
    else
        $administrative = function_exists("user_identity_contract_administrative_values")
            ? user_identity_contract_administrative_values($administrative_user)
            : user_identity_administrative_data($administrative_user);
    $administrative_role = "";
    if ($is_relation_administrative_profile)
    {
        $roles = [];
        foreach (user_relation_managed_children($id_profile_user) as $child)
            foreach (user_relation_labels($child["relation"] ?? "") as $label)
                if (in_array($label, ["Responsable légal", "Responsable financier"], true)
                    && !in_array($label, $roles, true))
                    $roles[] = $label;
        if (count($roles))
            $administrative_role = " — ".implode(" · ", $roles);
    }
?>
    <br />
    <fieldset class="profile_administrative_data">
        <legend><b><?=$Dictionnary["AdministrativeData"] ?? "Données administratives"; ?><?=htmlspecialchars($administrative_role); ?></b></legend>
        <p class="profile_administrative_notice">
            <?=$can_edit_administrative
                ? ($Dictionnary["AdministrativeDataEditableNotice"] ?? "Ces informations sont utilisées pour les contrats et documents administratifs.")
                : ($Dictionnary["AdministrativeDataReadOnlyNotice"] ?? "Ces informations sont visibles uniquement par vous et les personnels autorisés."); ?>
        </p>
        <form method="put" action="/api/user/<?=$user->id; ?>/administrative_data" onsubmit="return <?=$js; ?>">
            <input type="hidden" name="action" value="administrative_data" />
            <table>
                <?php foreach ($administrative_fields as $field => $type) {
                    $value = $administrative[$field] ?? ($type == "boolean" ? false : "");
                ?>
                    <tr><td><b><?=htmlspecialchars($Dictionnary[$field] ?? $field); ?></b> :</td><td>
                        <?php if ($type == "boolean") { ?>
                            <?php if ($can_edit_administrative) { ?>
                                <select name="<?=$field; ?>" style="width: 100%; text-align: center;">
                                    <option value="0" <?=$value ? "" : "selected"; ?>><?=$Dictionnary["No"] ?? "Non"; ?></option>
                                    <option value="1" <?=$value ? "selected" : ""; ?>><?=$Dictionnary["Yes"] ?? "Oui"; ?></option>
                                </select>
                            <?php } else { ?>
                                <input type="text" readonly disabled="disabled" style="width: 100%; text-align: center;"
                                    value="<?=htmlspecialchars($value ? ($Dictionnary["Yes"] ?? "Oui") : ($Dictionnary["No"] ?? "Non"), ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?>" />
                            <?php } ?>
                        <?php } else { ?>
                            <input type="<?=in_array($type, ["date", "email", "tel"], true) ? $type : "text"; ?>" name="<?=$field; ?>" <?=$can_edit_administrative ? "" : 'readonly disabled="disabled"'; ?>
                                style="width: 100%; text-align: center;"
                                value="<?=htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?>" />
                        <?php } ?>
                    </td></tr>
                <?php } ?>
            </table>
            <?php if ($can_edit_administrative) { ?>
                <br /><p style="text-align: center;"><input type="button" style="width: 150px;" onclick="<?=$js; ?>" value="&#10003;" /></p>
            <?php } ?>
        </form>
        <?php if ($is_relation_administrative_profile && function_exists("registration_form_latest_signature_evidence")) {
            $signature_evidence = registration_form_latest_signature_evidence($id_profile_user);
            if ($signature_evidence != NULL) { ?>
