                    — preuve <code><?=htmlspecialchars(substr((string)$signature_evidence["evidence_sha256"], 0, 20)); ?>…</code>
                </p>
            <?php }
        } ?>
        <?php if ($can_send_administrative_form) { ?>
            <div class="profile_administrative_invitation">
                <form method="put" action="/api/user/<?=$user->id; ?>/registration" onsubmit="return silent_submit(this);">
                    <?php if ($profile_status == "prospect" && !$is_relation_administrative_profile) { ?>
                        <label>
                            <?=$Dictionnary["RegistrationFormKind"] ?? "Type de contrat"; ?>
                            <select name="kind">
                                <?php foreach (registration_form_kinds() as $kind) { ?>
                                    <option value="<?=htmlspecialchars($kind, ENT_QUOTES); ?>"><?=$kind; ?></option>
                                <?php } ?>
                            </select>
                        </label>
                    <?php } else { ?>
                        <input type="hidden" name="kind" value="<?=registration_form_profile_kind(); ?>" />
                    <?php } ?>
                    <input type="button"
                        value="<?=$Dictionnary["SendAdministrativeForm"] ?? "✉ Envoyer le formulaire"; ?>"
                        onclick="confirm('<?=htmlspecialchars($Dictionnary["AdministrativeFormConfirmSend"] ?? "Envoyer un formulaire administratif à cette personne ?", ENT_QUOTES); ?>') && silent_submit(this);" />
                </form>
            </div>
        <?php } ?>
    </fieldset>
<?php } ?>

