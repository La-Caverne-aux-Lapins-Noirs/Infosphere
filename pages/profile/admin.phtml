<?php
$profile_admin_user_id = (int)$user->id;
$can_manage_profile_relations = can_manage_user_relations($profile_admin_user_id);
$can_manage_profile_credentials = can_manage_user_credentials($profile_admin_user_id);
$can_manage_profile_account = is_admin() && $profile_admin_user_id != 1;
$can_generate_profile_diploma = can_generate_user_diploma($profile_admin_user_id);
$can_generate_profile_id_card = can_generate_user_id_card($profile_admin_user_id);

if (!$can_manage_profile_relations
    && !$can_manage_profile_credentials
    && !$can_manage_profile_account
    && !$can_generate_profile_diploma
    && !$can_generate_profile_id_card)
    return ;

$profile_account_user = nfc_card_user($profile_admin_user_id);
if ($profile_account_user == NULL)
    return ;
$profile_account_authority = (int)($profile_account_user["authority"] ?? USER);
$profile_relations = $can_manage_profile_relations
    ? fetch_user_relation_summary($profile_admin_user_id)
    : ["responsible_by" => [], "responsible_for" => []];
$profile_relation_candidates = $can_manage_profile_relations
    ? user_relation_candidate_parents($profile_admin_user_id)
    : [];
$profile_nfc_eligible = $can_manage_profile_credentials
    && nfc_card_user_is_eligible($profile_account_user);
$profile_diploma_schools = $can_generate_profile_diploma
    ? diploma_director_schools_for_user($profile_admin_user_id)
    : [];
$profile_diploma_titles = $can_generate_profile_diploma
    ? fetch_certification_titles()
    : [];
$profile_diploma_ready = false;
$profile_diploma_issue_date = "";
$profile_diploma_default_promotion = $can_generate_profile_diploma
    ? diploma_default_promotion_year($profile_admin_user_id)
    : diploma_promotion_year();
$profile_diploma_nickname = trim((string)($user->nickname ?? ""));
foreach ($profile_diploma_schools as &$profile_diploma_school)
{
    $profile_diploma_school["diploma_status"] = diploma_school_status($profile_diploma_school);
    $profile_diploma_school["diploma_issue_date"] = diploma_default_issue_date(
        $profile_admin_user_id, (int)$profile_diploma_school["id"]
    );
    if ($profile_diploma_issue_date == ""
        && $profile_diploma_school["diploma_status"]["ready"])
        $profile_diploma_issue_date = $profile_diploma_school["diploma_issue_date"];
    $profile_diploma_ready = $profile_diploma_ready || $profile_diploma_school["diploma_status"]["ready"];
}
unset($profile_diploma_school);
$profile_id_card_schools = $can_generate_profile_id_card
    ? id_card_director_schools_for_user($profile_admin_user_id)
    : [];
$profile_id_card_ready = false;
$profile_id_card_default_study_year = "";
$profile_id_card_max_study_year = 5;
$profile_existing_id_cards = [];
foreach ($profile_id_card_schools as &$profile_id_card_school)
{
    $profile_id_card_school["id_card_status"] = id_card_school_status($profile_id_card_school);
    $profile_id_card_school["study_year"] = id_card_user_current_course(
        $profile_admin_user_id, (int)$profile_id_card_school["id"]
    );
    $profile_id_card_ready = $profile_id_card_ready || $profile_id_card_school["id_card_status"]["ready"];
    if ($profile_id_card_default_study_year == ""
        && $profile_id_card_school["id_card_status"]["ready"])
        $profile_id_card_default_study_year = (string)$profile_id_card_school["study_year"];
    if ((int)$profile_id_card_school["study_year"] > $profile_id_card_max_study_year)
        $profile_id_card_max_study_year = (int)$profile_id_card_school["study_year"];
    $profile_id_card_path = id_card_absolute_path(id_card_output_path($profile_account_user, $profile_id_card_school));
    if (is_file($profile_id_card_path))
        $profile_existing_id_cards[] = [
            "school" => $profile_id_card_school,
            "filename" => basename($profile_id_card_path),
        ];
}
unset($profile_id_card_school);
