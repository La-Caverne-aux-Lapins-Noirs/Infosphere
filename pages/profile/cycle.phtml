$profile_object_name = static function ($object) {
    $name = trim((string)$object->name);
    if ($name == "")
        $name = trim((string)$object->codename);
    return ($name);
};

$profile_compare_names = static function ($a, $b) use ($profile_object_name) {
    $aname = $profile_object_name($a);
    $bname = $profile_object_name($b);
    if (($cmp = strnatcasecmp($aname, $bname)) != 0)
        return ($cmp);
    if (($cmp = strcmp($aname, $bname)) != 0)
        return ($cmp);
    return ((int)$a->id <=> (int)$b->id);
};

$profile_activity_date = static function ($activity) {
    // Une session ne doit ordonner l'activité que lorsqu'elle correspond à
    // une inscription effective de l'étudiant.
    if ($activity->registered && $activity->id_session != -1 && $activity->begin_date != NULL)
        return ((int)$activity->begin_date);
    if ($activity->subject_appeir_date != NULL)
        return ((int)$activity->subject_appeir_date);
    if ($activity->full_activity != NULL && $activity->full_activity->registration_date != NULL)
        return ((int)$activity->full_activity->registration_date);
    return (NULL);
};

$profile_compare_activities = static function ($a, $b) use ($profile_activity_date, $profile_compare_names) {
    $adate = $profile_activity_date($a);
    $bdate = $profile_activity_date($b);
    if ($adate === NULL && $bdate !== NULL)
        return (1);
    if ($adate !== NULL && $bdate === NULL)
        return (-1);
    if ($adate !== NULL && $bdate !== NULL && $adate != $bdate)
        return ($adate <=> $bdate);
    return ($profile_compare_names($a, $b));
};

