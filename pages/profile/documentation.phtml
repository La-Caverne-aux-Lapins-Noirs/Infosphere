<script>
var profileDocumentationContextReference = '';
var profileDocumentationContextAutofillTimer = null;
var profileDocumentationContextAutofillSerial = 0;
var profileDocumentationOwner = <?=json_encode((string)$user->codename, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
var profileDocumentationDirectorChoices = <?=json_encode(array_values(array_filter(array_map(function ($director) {
    $id = (int)($director["id_director"] ?? $director["id_user"] ?? $director["id"] ?? 0);
    if ($id <= 0)
        return NULL;
    $label = trim((string)($director["identity"] ?? $director["codename"] ?? ""));
    return ["value" => (string)$id, "label" => $label != "" ? $label : (string)$id];
}, is_array($documentation_school["director"] ?? NULL) ? $documentation_school["director"] : []))), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;

function profile_documentation_selected_model(form)
{
    return form.querySelector('[name="document_model"] option:checked');
}

function profile_documentation_context_schema(form)
{
    var option = profile_documentation_selected_model(form);
    if (!option)
        return {};
    try { return JSON.parse(option.getAttribute('data-contexts') || '{}'); }
    catch (e) { return {}; }
}

function profile_documentation_context_bindings(form, includeAutomatic)
{
    if (typeof includeAutomatic === 'undefined')
        includeAutomatic = true;
    var out = {};
    form.querySelectorAll('[data-document-context-row]').forEach(function (row) {
        if (!includeAutomatic && row.getAttribute('data-context-origin') === 'automatic')
            return;
        var name = row.getAttribute('data-context-name') || '';
        var control = row.querySelector('[data-context-value]');
        var value = control ? String(control.value || '').trim() : '';
        if (name && value)
            out[name] = value;
    });
    return out;
}

function profile_documentation_context_placeholder(definition)
{
    if (definition.placeholder)
        return definition.placeholder;
    switch ((definition.type || '').toLowerCase())
    {
        case 'school': return 'id ou nom de code de l’école';
        case 'title_session': return 'id de la session de titre';
        case 'organization': return 'id ou nom de l’organisation';
        case 'tutor': return 'id ou nom de code du tuteur';
        case 'jury': return 'id ou nom de code du juré';
        default: return 'id ou nom de code';
    }
}

function profile_documentation_context_find_row(form, name)
{
    var rows = form.querySelectorAll('[data-document-context-row][data-context-name]');
    for (var i = 0; i < rows.length; ++i)
        if ((rows[i].getAttribute('data-context-name') || '') === name)
            return rows[i];
    return null;
}

function profile_documentation_context_add(form, name, value, origin, focus)
{
    var schema = profile_documentation_context_schema(form);
    var definition = schema[name];
    var target = form.querySelector('[data-document-context-list]');
    if (!definition || !target)
        return null;
    if (typeof value === 'undefined') value = '';
    if (!origin) origin = 'explicit';
    if (typeof focus === 'undefined') focus = true;
    var old = profile_documentation_context_find_row(form, name);
    if (old)
    {
        if (origin === 'explicit')
            old.setAttribute('data-context-origin', 'explicit');
        var oldControl = old.querySelector('[data-context-value]');
        if (oldControl && value !== '')
            oldControl.value = value;
        var oldLabel = old.querySelector('label');
        if (oldLabel)
            oldLabel.textContent = (definition.label || name) + (definition.required ? ' *' : '') + (origin === 'automatic' ? ' — automatique' : '');
        if (oldControl && focus)
            oldControl.focus();
        return old;
    }

    var row = document.createElement('div');
    row.setAttribute('data-document-context-row', '1');
    row.setAttribute('data-context-name', name);
    row.setAttribute('data-context-origin', origin);
    row.style.display = 'grid';
    row.style.gridTemplateColumns = 'minmax(150px, 1fr) minmax(190px, 2fr) auto';
    row.style.gap = '6px';
    row.style.margin = '4px 0';

    var label = document.createElement('label');
    label.textContent = (definition.label || name) + (definition.required ? ' *' : '') + (origin === 'automatic' ? ' — automatique' : '');
    var control;
    if (origin !== 'automatic' && (definition.type || '').toLowerCase() === 'director' && profileDocumentationDirectorChoices.length)
    {
        control = document.createElement('select');
        var empty = document.createElement('option');
        empty.value = '';
        empty.textContent = 'Choisir…';
        control.appendChild(empty);
        profileDocumentationDirectorChoices.forEach(function (choice) {
            var option = document.createElement('option');
            option.value = choice.value;
            option.textContent = choice.label;
            control.appendChild(option);
        });
    }
    else
    {
        control = document.createElement('input');
        control.type = 'text';
        control.placeholder = profile_documentation_context_placeholder(definition);
    }
    control.setAttribute('data-context-value', '1');
    control.value = value;
    function makeExplicit() {
        row.setAttribute('data-context-origin', 'explicit');
        label.textContent = (definition.label || name) + (definition.required ? ' *' : '');
        profile_documentation_refresh_contexts(form, false);
        profile_documentation_schedule_context_autofill(form);
    }
    control.addEventListener('input', makeExplicit);
    control.addEventListener('change', makeExplicit);

    var remove = document.createElement('input');
    remove.type = 'button';
    remove.value = '×';
    remove.addEventListener('click', function () {
        row.remove();
        profile_documentation_refresh_contexts(form, false);
        profile_documentation_schedule_context_autofill(form);
    });
    row.appendChild(label);
    row.appendChild(control);
    row.appendChild(remove);
    target.appendChild(row);
    profile_documentation_refresh_contexts(form, false);
    if (focus) control.focus();
    return row;
}

function profile_documentation_schedule_context_autofill(form)
{
    if (profileDocumentationContextAutofillTimer !== null)
        window.clearTimeout(profileDocumentationContextAutofillTimer);
    profileDocumentationContextAutofillTimer = window.setTimeout(function () {
        profileDocumentationContextAutofillTimer = null;
        profile_documentation_context_autofill(form);
    }, 180);
}

function profile_documentation_context_autofill(form)
{
    var option = profile_documentation_selected_model(form);
    if (!option || !option.value)
        return;
    var schema = profile_documentation_context_schema(form);
    var explicit = profile_documentation_context_bindings(form, false);
    var seededAutomatic = [];
    Object.keys(schema).forEach(function (name) {
        var auto = (schema[name].auto || '').toLowerCase();
        if (!explicit[name] && auto === 'owner' && profileDocumentationOwner)
        {
            explicit[name] = profileDocumentationOwner;
            seededAutomatic.push(name);
        }
    });

    var hash = option.getAttribute('data-form-hash') || '';
    if (!hash)
        return;
    var serial = ++profileDocumentationContextAutofillSerial;
    var data = new FormData();
    data.set('doc_' + hash, '1');
    data.set('docref_' + hash, option.value);
    data.set('context_bindings', JSON.stringify(explicit));
    fetch('/api/doc/0/context', {method: 'POST', body: data, credentials: 'same-origin'})
        .then(function (response) { return response.json(); })
        .then(function (payload) {
            if (serial !== profileDocumentationContextAutofillSerial || !payload || payload.result !== 'ok')
                return;
            var automatic = new Set((payload.automatic || []).concat(seededAutomatic));
            var full = payload.bindings || {};
            var explicitNow = profile_documentation_context_bindings(form, false);
            form.querySelectorAll('[data-document-context-row][data-context-origin="automatic"]').forEach(function (row) {
                var name = row.getAttribute('data-context-name') || '';
                if (!automatic.has(name) || !full[name] || explicitNow[name])
                    row.remove();
            });
            automatic.forEach(function (name) {
                if (explicitNow[name] || !full[name])
                    return;
                profile_documentation_context_add(form, name, full[name], 'automatic', false);
            });
            profile_documentation_refresh_contexts(form, false);
        });
}

function profile_documentation_refresh_contexts(form, reset)
{
    var option = profile_documentation_selected_model(form);
    var target = form.querySelector('[data-document-contexts]');
    var list = form.querySelector('[data-document-context-list]');
    var buttons = form.querySelector('[data-document-context-buttons]');
    var status = form.querySelector('[data-document-context-status]');
    if (!target || !list || !buttons || !status)
        return;

    var reference = option ? (option.value || '') : '';
    if (reset || reference !== profileDocumentationContextReference)
    {
        profileDocumentationContextReference = reference;
        list.innerHTML = '';
    }
    buttons.innerHTML = '';
    if (!option || !reference)
    {
        target.style.display = 'none';
        return;
    }

    var schema = profile_documentation_context_schema(form);
    var names = Object.keys(schema);
    if (!names.length)
    {
        target.style.display = 'none';
        return;
    }
    target.style.display = '';
    var bindings = profile_documentation_context_bindings(form);
    var missing = [];

    names.forEach(function (name) {
        var definition = schema[name];
        var row = profile_documentation_context_find_row(form, name);
        var explicit = !!bindings[name];
        var automatic = explicit && row && row.getAttribute('data-context-origin') === 'automatic';
        if (definition.required && !explicit)
            missing.push(definition.label || name);

        var button = document.createElement('input');
        button.type = 'button';
        if (explicit)
        {
            button.value = '✓ ' + (definition.label || name) + (automatic ? ' (automatique)' : '');
            button.disabled = true;
        }
        else
        {
            button.value = '+ ' + (definition.label || name) + (definition.required ? ' *' : '');
            button.addEventListener('click', function () { profile_documentation_context_add(form, name); });
        }
        buttons.appendChild(button);
    });

    status.textContent = missing.length
        ? 'Contexte requis restant : ' + missing.join(', ')
        : 'Le contexte est complet. Les valeurs trouvées automatiquement sont affichées ci-dessus.';
    var hidden = form.querySelector('[name="context_bindings"]');
    if (hidden)
        hidden.value = JSON.stringify(bindings);
    if (reset)
        profile_documentation_schedule_context_autofill(form);
}

function profile_documentation_validate_contexts(form)
{
    var schema = profile_documentation_context_schema(form);
    var bindings = profile_documentation_context_bindings(form);
    var missing = Object.keys(schema).filter(function (name) {
        return schema[name].required && !bindings[name];
    });
    if (!missing.length)
        return true;
    alert('Veuillez définir le contexte requis : ' + missing.map(function (name) { return schema[name].label || name; }).join(', '));
    return false;
}

function profile_documentation_set_action_busy(form, button, busy)
{
    var row = form && form.closest ? form.closest('tr') : null;
    var scope = row || form;
    if (!scope)
        return true;

    if (busy)
    {
        if (scope.getAttribute('data-document-action-busy') === '1')
            return false;
        scope.setAttribute('data-document-action-busy', '1');
        scope.classList.add('document-action-busy');
        scope.querySelectorAll('input[type="button"], button').forEach(function (control) {
            control.setAttribute('data-document-was-disabled', control.disabled ? '1' : '0');
            control.disabled = true;
        });
        if (button && typeof button.value !== 'undefined')
        {
            button.setAttribute('data-document-old-value', button.value);
            button.value = <?=json_encode($Dictionnary["DocumentActionInProgress"] ?? "Traitement…", JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
        }
        var actions = row ? row.querySelector('.document_workflow_actions') : null;
        if (actions && !actions.querySelector('.document-action-status'))
        {
            var status = document.createElement('span');
            status.className = 'document-action-status';
            status.textContent = <?=json_encode($Dictionnary["DocumentActionInProgress"] ?? "Traitement…", JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
            actions.appendChild(status);
        }
        return true;
    }

    scope.removeAttribute('data-document-action-busy');
    scope.classList.remove('document-action-busy');
    scope.querySelectorAll('input[type="button"], button').forEach(function (control) {
        var wasDisabled = control.getAttribute('data-document-was-disabled');
        if (wasDisabled !== null)
        {
            control.disabled = wasDisabled === '1';
            control.removeAttribute('data-document-was-disabled');
        }
    });
    if (button && button.getAttribute)
    {
        var oldValue = button.getAttribute('data-document-old-value');
        if (oldValue !== null)
        {
            button.value = oldValue;
            button.removeAttribute('data-document-old-value');
        }
    }
    var status = row ? row.querySelector('.document-action-status') : null;
    if (status)
        status.remove();
    return true;
}

function profile_documentation_submit_action(form, button, afterSuccess)
{
    if (!profile_documentation_set_action_busy(form, button, true))
        return false;
    return silent_submitf(form, {
        after_success: function (result, msg, content, parameter) {
            var refresh = afterSuccess
                ? afterSuccess(result, msg, content, parameter)
                : profile_documentation_refresh_workflow(true);
            if (refresh && typeof refresh.finally === 'function')
                refresh.finally(function () { profile_documentation_set_action_busy(form, button, false); });
            else
                profile_documentation_set_action_busy(form, button, false);
        },
        after_complete: function (success) {
            if (!success)
                profile_documentation_set_action_busy(form, button, false);
        }
    });
}

function profile_documentation_start(form, button)
{
    var option = profile_documentation_selected_model(form);
    if (!option || !option.value)
        return false;
    if (!profile_documentation_validate_contexts(form))
        return false;
    form.querySelector('[name="document_file"]').value = option.getAttribute('data-form-file') || '';
    form.querySelector('[name="model_hash"]').value = option.getAttribute('data-form-hash') || '';
    form.querySelector('[name="context_bindings"]').value = JSON.stringify(profile_documentation_context_bindings(form));
    return profile_documentation_submit_action(form, button);
}

