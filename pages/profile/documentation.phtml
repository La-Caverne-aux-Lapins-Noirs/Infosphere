}

function profile_documentation_finalize(form, button)
{
    if (!profile_documentation_set_action_busy(form, button, true))
        return false;
    var refreshPromise = null;
    var target = window.open('about:blank', '_blank');
    if (button)
        button.value = <?=json_encode($Dictionnary["Generating"] ?? "Génération…", JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;

    fetch(form.getAttribute('action'), {
        method: (form.getAttribute('method') || 'POST').toUpperCase(),
        credentials: 'same-origin',
        body: new FormData(form)
    }).then(function (response) {
        var type = (response.headers.get('Content-Type') || '').toLowerCase();
        if (type.indexOf('application/json') !== -1)
            return response.json().then(function (packet) {
                if (!packet || packet.result !== 'ok')
                    throw new Error(packet && packet.msg ? packet.msg : (response.statusText || 'Erreur de génération.'));
                throw new Error('La génération n\'a renvoyé aucun PDF.');
            });
        if (!response.ok)
            throw new Error(response.statusText || 'Erreur de génération.');
        return response.blob();
    }).then(function (blob) {
        var pdf = new Blob([blob], {type: 'application/pdf'});
        var url = URL.createObjectURL(pdf);
        if (target)
            target.location.href = url;
        else
            window.open(url, '_blank', 'noopener');
        window.setTimeout(function () { URL.revokeObjectURL(url); }, 60000);
        refreshPromise = profile_documentation_refresh_workflow(true);
        window.setTimeout(profile_documentation_refresh_generated_files, 1200);
    }).catch(function (error) {
        if (target)
            target.close();
        var message = error && error.message ? error.message : 'Erreur de génération.';
        if (typeof set_error_div === 'function')
            set_error_div(message, false);
        else
            window.alert(message);
    }).finally(function () {
        if (refreshPromise && typeof refreshPromise.finally === 'function')
            refreshPromise.finally(function () { profile_documentation_set_action_busy(form, button, false); });
        else
            profile_documentation_set_action_busy(form, button, false);
    });
    return false;
}

document.addEventListener('visibilitychange', function () {
    if (!document.hidden)
        profile_documentation_schedule_workflow_refresh(0);
});
profile_documentation_schedule_workflow_refresh();

function profile_documentation_refresh(result, msg, content, parameter)
{
    if (content && content.length)
        window.open(content, '_blank').focus();
    var browser = document.getElementById(parameter);
    if (browser)
    {
        var refresh = browser.previousElementSibling;
        if (refresh)
            silent_submit(refresh, parameter);
    }
}

function profile_open_generated_letter(result, msg, content, parameter)
{
    if (content && content.length)
        window.open(content, '_blank').focus();
    var browser = document.getElementById(parameter);
    if (browser)
    {
        var refresh = browser.previousElementSibling;
        if (refresh)
            silent_submit(refresh, parameter);
    }
}
