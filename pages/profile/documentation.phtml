<script>
var profileDocumentationSignatureSources = {
    Student: {type: 'student', id: <?=json_encode($user->codename, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>, label: 'Student'},
    Director: {type: 'director', id: <?=json_encode($documentation_school_codename, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>, label: 'Director'},
    Legal1: {type: 'legal1', id: <?=json_encode($user->codename, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>, label: 'Legal1'},
    Legal2: {type: 'legal2', id: <?=json_encode($user->codename, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>, label: 'Legal2'},
    Finance: {type: 'finance', id: <?=json_encode($user->codename, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>, label: 'Finance'},
    Generator: {type: 'user', id: <?=json_encode($documentation_generator_id); ?>, label: 'Generator'}
};

function profile_documentation_selected_model(form)
{
    return form.querySelector('[name="document_model"] option:checked');
}

function profile_documentation_signature_schema(form)
{
    var option = profile_documentation_selected_model(form);
    if (!option)
        return {};
    try { return JSON.parse(option.getAttribute('data-signatures') || '{}'); }
    catch (e) { return {}; }
}

function profile_documentation_signature_bindings(form)
{
    var out = {};
    form.querySelectorAll('[data-signature-slot]').forEach(function (select) {
        if (select.value)
            out[select.getAttribute('data-signature-slot')] = select.value;
    });
    return out;
}

function profile_documentation_refresh_signatures(form)
{
    var target = form.querySelector('[data-document-signatures]');
    if (!target)
        return;
    target.innerHTML = '';
    var schema = profile_documentation_signature_schema(form);
    var slots = Object.keys(schema);
    if (!slots.length)
    {
        target.style.display = 'none';
        return;
    }
    target.style.display = '';
    slots.forEach(function (slot) {
        var row = document.createElement('div');
        row.style.display = 'grid';
        row.style.gridTemplateColumns = 'minmax(110px, 1fr) minmax(180px, 2fr)';
        row.style.gap = '6px';
        row.style.margin = '4px 0';
        var label = document.createElement('label');
        label.textContent = slot + (schema[slot].required ? ' *' : '');
        var select = document.createElement('select');
        select.setAttribute('data-signature-slot', slot);
        select.style.width = '100%';
        var empty = document.createElement('option');
        empty.value = '';
        empty.textContent = '—';
        select.appendChild(empty);
        Object.keys(profileDocumentationSignatureSources).forEach(function (key) {
            var source = profileDocumentationSignatureSources[key];
            if (!source.id)
                return;
            var option = document.createElement('option');
            option.value = key;
            option.textContent = source.label;
            if (key === slot)
                option.selected = true;
            select.appendChild(option);
        });
        row.appendChild(label);
        row.appendChild(select);
        target.appendChild(row);
    });
}

function profile_documentation_validate_signatures(form)
{
    var schema = profile_documentation_signature_schema(form);
    var bindings = profile_documentation_signature_bindings(form);
    var missing = Object.keys(schema).filter(function (slot) {
        return schema[slot].required && !bindings[slot];
    });
    if (!missing.length)
        return true;
    alert(<?=json_encode($Dictionnary["DocumentRequiredSignatories"] ?? "Veuillez définir tous les signataires obligatoires : ", JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?> + missing.join(', '));
    return false;
}

function profile_documentation_signature_chain(form)
{
    var bindings = profile_documentation_signature_bindings(form);
    var chain = [];
    Object.keys(bindings).forEach(function (slot) {
        var source = profileDocumentationSignatureSources[bindings[slot]];
        if (!source || !source.id)
            return;
        chain.push({type: source.type, prefix: 'SignatureSources.' + slot, id: source.id, signatory: slot});
    });
    return chain;
}

function profile_documentation_chain(form)
{
    var student = <?=json_encode($user->codename, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
    var school = <?=json_encode($documentation_school_codename, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
    var year = parseInt(form.querySelector('[name="target_year"]').value, 10);
    var chain = [];

    if (school)
        chain.push({type: 'school', prefix: 'School', id: school});
    chain.push({type: 'student', prefix: 'Student', id: student});
    chain = chain.concat(profile_documentation_signature_chain(form));

    if (Number.isInteger(year) && year >= 1 && year <= 5)
    {
        chain.push(
            {type: 'field', key: 'Student.ChosenClass', value: 'EF' + year},
            {type: 'field', key: 'Student.CurrentYear', value: String(year)}
        );
        var bindings = profile_documentation_signature_bindings(form);
        Object.keys(bindings).forEach(function (slot) {
            if (bindings[slot] === 'Student')
            {
                chain.push(
                    {type: 'field', key: 'SignatureSources.' + slot + '.ChosenClass', value: 'EF' + year},
                    {type: 'field', key: 'SignatureSources.' + slot + '.CurrentYear', value: String(year)}
                );
            }
        });
    }
    return chain;
}

function profile_documentation_prepare(form)
{
    var option = form.querySelector('[name="document_model"] option:checked');
    if (!option || !option.value)
        return false;
    if (!profile_documentation_validate_signatures(form))
        return false;
    form.querySelector('[name="docref_profile_document"]').value = option.value;
    form.querySelector('[name="chain"]').value = JSON.stringify(profile_documentation_chain(form));
    form.querySelector('[name="form_output"]').value = 'user-document:<?=((int)$user->id); ?>:' + option.getAttribute('data-form-hash') + ':' + (form.querySelector('[name="target_year"]').value || '0');
    form.querySelector('[name="signature_bindings"]').value = JSON.stringify(profile_documentation_signature_bindings(form));
    return true;
}

function profile_documentation_complete(form)
{
    var option = form.querySelector('[name="document_model"] option:checked');
    if (!option || !option.value)
        return false;
    if (!profile_documentation_validate_signatures(form))
        return false;
    var output = 'user-document:<?=((int)$user->id); ?>:' + option.getAttribute('data-form-hash') + ':' + (form.querySelector('[name="target_year"]').value || '0');
    var url = 'index.php?p=DabsicFormMenu' +
        '&file=' + encodeURIComponent(option.getAttribute('data-form-file')) +
        '&output=' + encodeURIComponent(output) +
        '&mode=docbuilder' +
        '&chain=' + encodeURIComponent(JSON.stringify(profile_documentation_chain(form)));
    window.open(url, '_blank', 'noopener');
    return false;
}

function profile_documentation_send(form)
{
    var option = form.querySelector('[name="document_model"] option:checked');
    if (!option || !option.value)
        return false;
    if (!profile_documentation_validate_signatures(form))
        return false;
    var send = document.getElementById('profile-documentation-send-form');
    if (!send)
        return false;
    send.querySelector('[name="document_file"]').value = option.getAttribute('data-form-file') || '';
    send.querySelector('[name="model_hash"]').value = option.getAttribute('data-form-hash') || '';
    send.querySelector('[name="document_label"]').value = option.textContent.trim();
    send.querySelector('[name="target_year"]').value = form.querySelector('[name="target_year"]').value || '0';
    send.querySelector('[name="signature_bindings"]').value = JSON.stringify(profile_documentation_signature_bindings(form));
    return silent_submitf(send, {after_success: profile_documentation_form_sent});
}

function profile_documentation_form_sent(result, msg, content, parameter)
{
    if (content && content.length)
        console.log('Formulaire documentaire : ' + content);
}

function profile_documentation_refresh(result, msg, content, parameter)
{
    if (content && content.length)
        window.open(content, '_blank').focus();
    var browser = document.getElementById(parameter);
    if (browser)
    {
        var refresh = browser.previousElementSibling;
        if (refresh)
            silent_submit(refresh, parameter);
    }
}

function profile_open_generated_letter(result, msg, content, parameter)
{
    if (content && content.length)
        window.open(content, '_blank').focus();
    var browser = document.getElementById(parameter);
    if (browser)
    {
        var refresh = browser.previousElementSibling;
        if (refresh)
            silent_submit(refresh, parameter);
    }
}
