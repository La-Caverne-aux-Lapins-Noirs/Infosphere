var profileDocumentationWorkflowRefreshTimer = null;
var profileDocumentationWorkflowRefreshDelay = 10000;

function profile_documentation_schedule_workflow_refresh(delay)
{
    if (profileDocumentationWorkflowRefreshTimer)
        window.clearTimeout(profileDocumentationWorkflowRefreshTimer);
    profileDocumentationWorkflowRefreshTimer = window.setTimeout(function () {
        profile_documentation_refresh_workflow(false);
    }, typeof delay === 'number' ? delay : profileDocumentationWorkflowRefreshDelay);
}

function profile_documentation_refresh_workflow(force)
{
    var host = document.getElementById('profile-documentation-workflow-state');
    if (!host)
        return Promise.resolve(false);
    if (!force && (document.hidden || host.offsetParent === null))
    {
        profile_documentation_schedule_workflow_refresh();
        return Promise.resolve(false);
    }

    return fetch(window.location.href, {
        method: 'GET',
        credentials: 'same-origin',
        cache: 'no-store',
        headers: {'X-Requested-With': 'XMLHttpRequest'}
    }).then(function (response) {
        if (!response.ok)
            throw new Error(response.statusText || 'Erreur de rafraîchissement.');
        return response.text();
    }).then(function (html) {
        var documentCopy = new DOMParser().parseFromString(html, 'text/html');
        var fresh = documentCopy.getElementById('profile-documentation-workflow-state');
        if (fresh && host.innerHTML !== fresh.innerHTML)
            host.innerHTML = fresh.innerHTML;
    }).catch(function (error) {
        console.warn('Actualisation du suivi documentaire impossible :', error);
    }).finally(function () {
        profile_documentation_schedule_workflow_refresh();
    });
}

function profile_documentation_refresh_generated_files()
{
    var browser = document.getElementById('documentation_file_browser');
    if (!browser)
        return;
    var refresh = browser.previousElementSibling;
    if (refresh)
        silent_submit(refresh, 'documentation_file_browser');
}

function profile_documentation_form_sent(result, msg, content, parameter)
{
