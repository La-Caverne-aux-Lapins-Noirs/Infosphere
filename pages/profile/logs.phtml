<?php
if (!is_director_for_student($user->id))
    return ;
require_once (__DIR__."/../../tools/log.php");

$profile_log_limit = 300;
$profile_user_id = (int)$user->id;
$profile_logs = db_select_all("
    log.id, log.id_user, log.log_date, log.type, log.message, log.url,
    author.codename as codename,
    GROUP_CONCAT(DISTINCT CONCAT(log_context.misc_type, '#', log_context.id_misc) ORDER BY log_context.misc_type, log_context.id_misc SEPARATOR ', ') as contexts
    FROM log
    LEFT JOIN user as author ON author.id = log.id_user
    LEFT JOIN log_context ON log_context.id_log = log.id
    WHERE log.id_user = $profile_user_id
       OR EXISTS (
           SELECT 1 FROM log_context lc_user
           WHERE lc_user.id_log = log.id
             AND lc_user.misc_type = 'user'
             AND lc_user.id_misc = $profile_user_id
       )
       OR log.url = 'user$profile_user_id'
       OR log.url LIKE '%user$profile_user_id%'
    GROUP BY log.id
    ORDER BY log.log_date DESC, log.id DESC
    LIMIT $profile_log_limit
");
?>
