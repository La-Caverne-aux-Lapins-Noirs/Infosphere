<?php foreach ($profile_logs as $log) { ?>
    <tr>
        <td>#<?=htmlentities($log["id"]); ?></td>
        <td><?=human_date($log["log_date"]); ?></td>
        <td><?=htmlentities($log["codename"] ?? $log["id_user"]); ?></td>
        <td><?=htmlentities($log["type"]); ?></td>
        <td class="profile_log_message"><?=htmlentities($log["message"]); ?></td>
        <td class="profile_log_context">
            <?php if (@strlen($log["contexts"])) { ?>
                <?php foreach (array_map("trim", explode(",", $log["contexts"])) as $context) { ?>
                    <?php if ($context != "") { ?><span><?=htmlentities($context); ?></span><?php } ?>
                <?php } ?>
            <?php } else { ?>
                <?=htmlentities($log["url"] ?? ""); ?>
            <?php } ?>
        </td>
    </tr>
<?php } ?>
</table>
