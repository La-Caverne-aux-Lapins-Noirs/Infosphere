<?php
/*
** $page : template ou module
** $path : le chemin du dossier ouvert depuis le dossier racine des ressources
** $target : le chemin du dosser ouvert depuis le dossier racine du site web
** $language : la langue qu'on utilise actuellement. NA si c'est pour toutes les langues
** $id: l'identifiant associé a l'element contenant tous ces fichiers
** $type : la nature des fichiers parcourus
** $fbid : la base du nom de l'id du navigateur
*/
$entries = [];
if (!isset($nocd))
    $nocd = false;
if (!isset($locked_path))
    $locked_path = "";
if (!isset($path_browser_can_cd))
    $path_browser_can_cd = !$nocd;
else
    $path_browser_can_cd = !!$path_browser_can_cd;
if (!isset($show_hidden_entries))
    $show_hidden_entries = false;
else
    $show_hidden_entries = !!$show_hidden_entries;
if (!isset($path_browser_dabsic_editor))
    $path_browser_dabsic_editor = false;
else
    $path_browser_dabsic_editor = !!$path_browser_dabsic_editor;
$locked_path = resolve_path($locked_path);
$current_path = resolve_path($path);
if (!isset($path_browser_root) || !@strlen($path_browser_root))
    $path_browser_root = isset($root) && @strlen($root)
        ? $root
        : path_browser_transfer_root_from_target($target, $path);
?>
<?php if ($target !== NULL) { ?>
    <?php
    $directories = [];
    $subfiles = [];
    ?>
    <?php foreach (scandir($target) as $content) { ?>
	<?php
	if ($content == "." || $content == "index.php")
	    continue ;
	if (isset($hidden_entries) && in_array($content, $hidden_entries, true))
	    continue ;
	if ($content == ".." && (
	    !$path_browser_can_cd ||
	    $current_path == "/" ||
	    $current_path == "" ||
	    ($locked_path != "" && $current_path == $locked_path)
	))
	    continue ;
	if (!$show_hidden_entries && $content != ".." && $content[0] == ".")
	    continue ;
        if ($page === "user" && $type === "file" && $content != "..")
        {
            $entry_relative = path_browser_transfer_relative_entry(
                $path_browser_root,
                $target.$content
            );
            if ($entry_relative === NULL
                || !user_storage_can_read_path((int)$id, $entry_relative))
                continue ;
        }
	if (is_dir($target.$content))
	    $directories[] = $target.$content;
	else
	    $subfiles[] = $target.$content;
	?>
    <?php } ?>
    <?php foreach (($entries = array_merge($directories, $subfiles)) as $content) { ?>
        <?php
        $content_extension = strtolower(pathinfo($content, PATHINFO_EXTENSION));
        $content_editor_url =
            $path_browser_dabsic_editor && !is_dir($content)
            ? dabsic_editor_url($content)
            : "";
        $content_is_editable_dabsic =
            $content_editor_url !== "" &&
            in_array($content_extension, dabsic_editor_editable_extensions(), true);
        $content_relative = path_browser_transfer_relative_entry($path_browser_root, $content);
        $content_is_user_storage_root =
            $page === "user" &&
            $type === "file" &&
            user_storage_is_root_space($content_relative);
        $content_browser_path = "";
        if (is_dir($content) && $path_browser_can_cd)
        {
            $content_browser_path = resolve_path($path.($path != "/" ? "/" : "").pathinfo($content, PATHINFO_BASENAME));
            if ($content_browser_path == "")
                $content_browser_path = "/";
        }
        ?>
	<div
	    class="icon <?=is_dir($content) ? "directory" : $content_extension; ?><?=$content_is_editable_dabsic ? " has_dabsic_editor" : ""; ?><?=pathinfo($content, PATHINFO_BASENAME) == ".." ? " path_browser_navigation" : ""; ?>"
            draggable="<?=pathinfo($content, PATHINFO_BASENAME) == ".." || $content_is_user_storage_root ? "false" : "true"; ?>"
            data-path-browser-relative="<?=htmlspecialchars((string)$content_relative, ENT_QUOTES); ?>"
            data-path-browser-name="<?=htmlspecialchars(pathinfo($content, PATHINFO_BASENAME), ENT_QUOTES); ?>"
            data-path-browser-directory="<?=is_dir($content) ? 1 : 0; ?>"
            <?php if ($content_browser_path !== "") { ?>data-path-browser-drop-path="<?=htmlspecialchars($content_browser_path, ENT_QUOTES); ?>"<?php } ?>
	    <?php if (in_array(pathinfo($content, PATHINFO_EXTENSION), ["jpg", "jpeg", "png", "gif", "bmp", "webp"])) { ?>
		style="background-image: url('<?=$content; ?>?<?=now(); ?>'); background-size: contain;"
	    <?php } ?>
	    <?php if (is_dir($content) && $path_browser_can_cd) { ?>
	        ondblclick="return path_browser_cd(this, <?=htmlspecialchars(json_encode($content_browser_path, JSON_UNESCAPED_SLASHES), ENT_QUOTES); ?>);"
	    <?php } else if (!is_dir($content)) { ?>
	        ondblclick="window.open('<?=$content; ?>', '_blank').focus();"
	    <?php } ?>
	>
	    <?php if (in_array(($ext = pathinfo($content, PATHINFO_EXTENSION)), ["ttf", "woff2"])) { ?>
		<div style="position: absolute; top: 0px; left: 0px; z-index: 1; font-family: fnt<?=md5(resolve_path($content)); ?>;">AaBbCc</div>
	    <?php } ?>
	    
	    <?php if (in_array(pathinfo($content, PATHINFO_EXTENSION), ["wav", "mp3", "ogg"])) { ?>
		<audio src="<?=$content; ?>?<?=now(); ?>" controls></audio>
	    <?php } ?>
	    <?php if (in_array(pathinfo($content, PATHINFO_EXTENSION), ["avi", "mp4", "ogv", "webm", "mkv"])) { ?>
		<video src="<?=$content; ?>?<?=now(); ?>" controls></video>
	    <?php } ?>

	    <?php if (pathinfo($content, PATHINFO_BASENAME) != ".." && !$content_is_user_storage_root) { ?>
                <div class="path_browser_entry_menu" draggable="false">
                    <button
                        type="button"
                        class="path_browser_entry_menu_button"
                        title="<?=htmlspecialchars($Dictionnary["PathBrowserMenu"], ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?>"
                        aria-label="<?=htmlspecialchars($Dictionnary["PathBrowserMenu"], ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?>"
                        aria-expanded="false"
                        draggable="false"
                        onclick="return path_browser_toggle_entry_menu(event, this);"
                    >&#8942;</button>
                    <div class="path_browser_entry_menu_popup" role="menu">
                        <?php if ($content_is_editable_dabsic) { ?>
                            <a
                                class="path_browser_entry_menu_item"
                                href="<?=htmlspecialchars($content_editor_url, ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?>"
                                role="menuitem"
                                draggable="false"
                                onclick="event.stopPropagation();"
                                ondblclick="event.stopPropagation();"
                            ><?=htmlspecialchars($Dictionnary["DabsicEditorOpen"], ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?></a>
                        <?php } ?>
                        <button
                            type="button"
                            class="path_browser_entry_menu_item"
                            role="menuitem"
                            draggable="false"
                            onclick="return path_browser_rename_entry(event, this);"
                        ><?=htmlspecialchars($Dictionnary["PathBrowserRename"], ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8"); ?></button>
                    </div>
                </div>

		<form action="<?=$api; ?>/<?=str_replace("/", "@", $content); ?>" method="delete" style="z-index: 3;">
		    <?php $this_field = "path".$fbid.$language.pathinfo($content, PATHINFO_BASENAME); ?>
		    <input type="hidden" name="path" id="<?=$this_field; ?>" value="" />
		    <input type="hidden" name="nocd" value="<?=$nocd ? 1 : 0; ?>" />
		    <input type="hidden" name="locked_path" value="<?=isset($locked_path) ? $locked_path : ""; ?>" />
		    <input type="hidden" name="path_browser_can_cd" value="<?=$path_browser_can_cd ? 1 : 0; ?>" />
		    <input type="hidden" name="show_hidden_entries" value="<?=$show_hidden_entries ? 1 : 0; ?>" />
                    <input type="hidden" name="path_browser_dabsic_editor" value="<?=$path_browser_dabsic_editor ? 1 : 0; ?>" />
		    <input type="hidden" name="fbid" value="<?=$fbid; ?>" />
		    <input type="hidden" name="language" value="<?=$language; ?>" />
		    <input type="button" onclick="
			if (ShiftPressed || window.confirm()) {
                            path_browser_fill_form_path(this);
			    silent_submit(this, '<?=$fbid.$language; ?>');
			}
			"
			value="&#10007;"
		    />
		</form>
	    <?php } ?>
	    <div class="filename" style="z-index: 2;"><?=pathinfo($content, PATHINFO_BASENAME); ?><?=is_dir($content) ? "/" : ""; ?></div>
	</div>
    <?php } ?>
<?php } ?>

<?php
$visible_entries = $entries;
if (!$show_hidden_entries)
{
    foreach ($visible_entries as $k => $in)
    {
	if (pathinfo($in, PATHINFO_BASENAME)[0] == ".")
	    unset($visible_entries[$k]);
    }
}
?>
<?php if (count($visible_entries) == 0) { ?>
    <p style="text-align: center;">
	<br />
	<?=$Dictionnary["Empty"]; ?>
	<br />
    </p>
<?php } ?>

