Document = "Invoice"
Title = "Facture"

[Contexts
  [Student
    Type = "student"
    Prefix = "Student"
    Label = "Élève / bénéficiaire"
    Auto = "Owner"
  ]
  [School
    Type = "school"
    Prefix = "School"
    Label = "École"
    Required = 1
    InferFrom = "Student"
  ]
  [Parent
    Type = "parent"
    Prefix = "Parent"
    Label = "Responsable légal"
    InferFrom = "Student"
  ]
  [Finance
    Type = "finance"
    Prefix = "Finance"
    Label = "Responsable financier / destinataire"
    InferFrom = "Student"
  ]
]

[InvoiceLayout
  TopMargin = "1cm"
  BottomMargin = "2cm"
  HeaderHeight = "1cm"
  HeaderGap = "0.45cm"
  FooterHeight = "2cm"
  FooterRuleGap = "0.12cm"

  ' Même géométrie d'enveloppe que les courriers administratifs.
  FromX = "2cm"
  FromY = "2.5cm"
  FromWidth = "7.5cm"
  TargetX = "11.5cm"
  TargetY = "5cm"
  TargetWidth = "7cm"
  BodyGap = "4cm"

  ' Le cadre de paiement reste au-dessus de l'en-pied légal.
  PaymentBottomGap = "0.45cm"
  PaymentBodyGap = "0.25cm"
]

[Header
  Right = [Text($,Right)
    [@IfC;School.DocumentLogo;!=;;
      [@Image;[#Variable;School.DocumentLogo];width=3cm;height=2cm]
    ]
  Right]
]

Footer = [Text($,Footer)
  [@Size;0]
  $(School.SchoolInfo)
  $(School.FormationInfo)
  $(School.AlternationInfo)
  $(School.DocumentInformation)
  $(School.OrganizationMainInfo)
  $(School.OrganizationPhone) $(School.OrganizationMail)
Footer]

BillingInformation = [].School.RIBDetails

[FormGroup
  @insert "res/docs/fr/.forms/invoice_groups.dab"
]

[FormRole
  @insert "res/docs/fr/.forms/invoice_roles.dab"
]

' Products/Items est un tableau de lignes interprété directement par DocBuilder Invoice.
' Chaque ligne accepte Content, Quantity, Price (HT) et VAT.
