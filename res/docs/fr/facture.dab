]

Footer = [Text($,Footer)
  [@Size;0]
  $(School.MainInfo)
  $(School.SchoolInfo)
  $(School.FormationInfo)
  $(School.AlternationInfo)
  $(School.Phone) $(School.Mail)
Footer]

BillingInformation = [].School.RIB

