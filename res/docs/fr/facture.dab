Document = "Invoice"
Title = "Facture"

[Contexts
  [Student
    Type = "student"
    Prefix = "Student"
    Label = "Élève / bénéficiaire"
    Auto = "Owner"
  ]
  [School
    Type = "school"
    Prefix = "School"
    Label = "École"
    Required = 1
    InferFrom = "Student"
  ]
  [Parent
    Type = "parent"
    Prefix = "Parent"
    Label = "Responsable légal"
    InferFrom = "Student"
  ]
  [Finance
    Type = "finance"
    Prefix = "Finance"
    Label = "Responsable financier / destinataire"
    InferFrom = "Student"
  ]
]

[Header
  Left = [Text($,Left)
    [@Size;5]
    [#Variable;School.LegalName]
  Left]
  Right = [Text($,Right)
    [@IfC;School.DocumentLogo;!=;;
      [@Image;[#Variable;School.DocumentLogo];width=3cm;height=2cm]
    ]
  Right]
]

Footer = [Text($,Footer)
  [@Size;0]
  $(School.MainInfo)
  $(School.SchoolInfo)
  $(School.FormationInfo)
  $(School.AlternationInfo)
  $(School.Phone) $(School.Mail)
Footer]

BillingInformation = [].School.RIB

[FormGroup
  @insert "res/docs/fr/.forms/invoice_groups.dab"
]

[FormRole
  @insert "res/docs/fr/.forms/invoice_roles.dab"
]

' Products/Items est un tableau de lignes interprété directement par DocBuilder Invoice.
' Chaque ligne accepte Content, Quantity, Price (HT) et VAT.
