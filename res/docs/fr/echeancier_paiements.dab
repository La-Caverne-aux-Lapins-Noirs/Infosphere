@include ".base_letter/base.dab"
Title = "Échéancier des paiements"

[School
  Name = ""
  LegalName = ""
  LegalAddress = ""
  LegalCity = ""
  Phone = ""
  Mail = ""
  DocumentLogo = ""
  MainInfo = ""
  SchoolInfo = ""
  FormationInfo = ""
  AlternationInfo = ""
]

[Student
  Identity = ""
  FirstName = ""
  FamilyName = ""
]

[Finance
  Identity = ""
  FirstName = ""
  FamilyName = ""
  Address = ""
  PostalCity = ""
  Country = ""
]

[PaymentSchedule
  GeneratedDate = ""
  CurrentYear = ""
  CurrentTotal = ""
  CurrentPaid = ""
  CurrentRemaining = ""
  PriorRemaining = ""
  TotalRemaining = ""
  Line01 = ""
  Line02 = ""
  Line03 = ""
  Line04 = ""
  Line05 = ""
  Line06 = ""
  Line07 = ""
  Line08 = ""
  Line09 = ""
  Line10 = ""
  Line11 = ""
  Line12 = ""
  Line13 = ""
  Line14 = ""
  Line15 = ""
  Line16 = ""
  Line17 = ""
  Line18 = ""
  Line19 = ""
  Line20 = ""
  Line21 = ""
  Line22 = ""
  Line23 = ""
  Line24 = ""
]

[Contexts
  [Student
    Type = "student"
    Prefix = "Student"
    Label = "Élève / bénéficiaire"
    Auto = "Owner"
    Required = 1
  ]
  [Finance
    Type = "finance"
    Prefix = "Finance"
    Label = "Responsable financier / destinataire"
    Required = 1
    InferFrom = "Student"
  ]
  [School
    Type = "school"
    Prefix = "School"
    Label = "École"
    Required = 1
    InferFrom = "Student"
  ]
]
[FormGroup
  [Echeancier
    Label = "Échéancier"
    [Fields
      [PaymentSchedule
        [GeneratedDate
          Label = "Date d'édition"
          Required = 1
        ]
        [CurrentYear
          Label = "Année de formation concernée"
        ]
        [CurrentTotal
          Label = "Montant prévu pour l'année"
        ]
        [CurrentPaid
          Label = "Déjà versé sur l'année"
        ]
        [CurrentRemaining
          Label = "Reste à régler sur l'année"
        ]
        [PriorRemaining
          Label = "Solde antérieur restant dû"
        ]
        [TotalRemaining
          Label = "Total restant à régler"
          Required = 1
        ]
        [Line01
          Label = "Échéance 1"
        ]
        [Line02
          Label = "Échéance 2"
        ]
        [Line03
          Label = "Échéance 3"
        ]
        [Line04
          Label = "Échéance 4"
        ]
        [Line05
          Label = "Échéance 5"
        ]
        [Line06
          Label = "Échéance 6"
        ]
        [Line07
          Label = "Échéance 7"
        ]
        [Line08
          Label = "Échéance 8"
        ]
        [Line09
          Label = "Échéance 9"
        ]
        [Line10
          Label = "Échéance 10"
        ]
        [Line11
          Label = "Échéance 11"
        ]
        [Line12
          Label = "Échéance 12"
        ]
        [Line13
          Label = "Échéance 13"
        ]
        [Line14
          Label = "Échéance 14"
        ]
        [Line15
          Label = "Échéance 15"
        ]
        [Line16
          Label = "Échéance 16"
        ]
        [Line17
          Label = "Échéance 17"
        ]
        [Line18
          Label = "Échéance 18"
        ]
        [Line19
          Label = "Échéance 19"
        ]
        [Line20
          Label = "Échéance 20"
        ]
        [Line21
          Label = "Échéance 21"
        ]
        [Line22
          Label = "Échéance 22"
        ]
        [Line23
          Label = "Échéance 23"
        ]
        [Line24
          Label = "Échéance 24"
        ]
      ]
    ]
  ]
]

[FormRole
  [Etablissement
    Label = "Établissement"
    {Read
      "Echeancier"
    }
    {Edit
      "Echeancier"
    }
    {Validate
      "Echeancier"
    }
  ]
]


[Header
  Left = [Text($,Left)
    [@Size;5] Échéancier des paiements
  Left]
]

From = [Text($,From)
  [#Variable;School.Name]\par
  [#Variable;School.LegalAddress]\par
  [#Variable;School.Phone]\par
  [#Variable;School.Mail]
From]

Target = [Text($,Target)
  [#Variable;Finance.Identity]\par
  [#Variable;Finance.Address]\par
  [#Variable;Finance.PostalCity][@IfC;Finance.Country;!=;;\par[#Variable;Finance.Country]]
Target]

Subject = [Text($,LetterSubject)
  Objet : Échéancier de financement de la scolarité — [#Variable;Student.Identity]
LetterSubject]

Date = [Text($,LetterDate)
  [#IfC;School.LegalCity;!=;;[#Variable;School.LegalCity], ;]le [#Variable;PaymentSchedule.GeneratedDate]
LetterDate]

{Content
  @insert txt ($) "echeancier_paiements.txt"
}
