@include ".base_convention_stage/main.dab"

Title = "Convention de stage"

'School
'Signatories.SchoolTutor
'Signatories.Student

'Company
'Signatories.CompanyTutor
 
[Signatures
  [SchoolTutor
    Required = 1
    Role = "Référent de l’établissement"
  ]
  [CompanyTutor
    Required = 1
    Role = "Tuteur de l’organisme d’accueil"
  ]
  [Student
    Required = 1
    Role = "Stagiaire"
  ]
]

[FormGroup
  @insert "res/docs/fr/.forms/internship_groups.dab"
]

[FormRole
  @insert "res/docs/fr/.forms/internship_roles.dab"
]
