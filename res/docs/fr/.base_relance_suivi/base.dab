@include "res/docs/fr/.base_letter/base.dab"

[School
  Name = ""
  LegalName = ""
  LegalAddress = ""
  LegalCity = ""
  TrainingAddress = ""
  Phone = ""
  Mail = ""
  DocumentLogo = ""
  MainInfo = ""
  SchoolInfo = ""
  FormationInfo = ""
  AlternationInfo = ""
]

[Student
  Identity = ""
  FirstName = ""
  FamilyName = ""
  Gender = ""
  Address = ""
  PostalCity = ""
  Country = ""
]

[FollowUp
  Reason = ""
  Period = ""
  Facts = ""
  PreviousContacts = ""
  ResponseDeadline = ""
  SupportProposal = ""
  MeetingProposal = ""
]

[Generation
  Date = ""
  Time = ""
  Datetime = ""
]

[Contexts
  [Student
    Type = "student"
    Prefix = "Student"
    Label = "Bénéficiaire"
    Auto = "Owner"
    Required = 1
  ]
  [School
    Type = "school"
    Prefix = "School"
    Label = "École"
    Required = 1
    InferFrom = "Student"
  ]
  [Director
    Type = "director"
    Prefix = "Director"
    Label = "Responsable signataire"
    Required = 1
    Signatory = "Director"
    InferFrom = "School"
  ]
]

[Signatures
  [Director
    Required = 1
    Role = "Direction"
  ]
]

[FormGroup
  [Beneficiaire
    Label = "Bénéficiaire"
    [Fields
      [Student
        [Identity
          Label = "Nom et prénom"
        ]
        [Address
          Label = "Adresse"
        ]
        [PostalCity
          Label = "Code postal et ville"
        ]
        [Country
          Label = "Pays"
        ]
      ]
    ]
  ]
  [Relance
    Label = "Relance et prévention de rupture"
    [Fields
      [FollowUp
        [Period
          Label = "Période concernée"
        ]
        [Facts
          Label = "Faits constatés"
          Required = 1
        ]
        [PreviousContacts
          Label = "Contacts / relances déjà effectués"
        ]
        [ResponseDeadline
          Label = "Date limite de prise de contact"
        ]
        [SupportProposal
          Label = "Mesure d'accompagnement proposée"
          Required = 1
        ]
        [MeetingProposal
          Label = "Proposition de rendez-vous"
        ]
      ]
    ]
  ]
  [Emission
    Label = "Émission"
    [Fields
      [Generation
        [Date
          Label = "Date d'émission"
        ]
      ]
      [Signatories
        [Director
          [Identity
            Label = "Responsable signataire"
          ]
        ]
      ]
    ]
  ]
]

[FormRole
  [Etablissement
    Label = "Établissement"
    {Read
      "Beneficiaire",
      "Relance",
      "Emission"
    }
    {Edit
      "Relance"
    }
    {Validate
      "Relance"
    }
  ]
]

From = [Text($,From)
  [#Variable;School.Name]\par
  [#Variable;School.LegalAddress]\par
  [#Variable;School.Phone]\par
  [#Variable;School.Mail]
From]

Target = [Text($,Target)
  [#Variable;Student.Identity]\par
  [#Variable;Student.Address]\par
  [#Variable;Student.PostalCity][@IfC;Student.Country;!=;;\par[#Variable;Student.Country]]
Target]

Date = [Text($,LetterDate)
  [#IfC;School.LegalCity;!=;;[#Variable;School.LegalCity], ;]le [#Variable;Generation.Date]
LetterDate]
