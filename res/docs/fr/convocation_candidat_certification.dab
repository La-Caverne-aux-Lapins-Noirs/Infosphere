@include ".base_letter/base.dab"
Title = "Convocation du candidat à une session de certification"

[School
  Name = ""
  LegalName = ""
  LegalAddress = ""
  LegalCity = ""
  TrainingAddress = ""
  Phone = ""
  Mail = ""
  DocumentLogo = ""
  MainInfo = ""
  SchoolInfo = ""
  FormationInfo = ""
  AlternationInfo = ""
]

[Student
  Identity = ""
  Address = ""
  PostalCity = ""
  Country = ""
  Gender = ""
]

[Candidate
  Number = ""
  QuestionnaireDate = ""
  QuestionnaireTime = ""
  JuryDate = ""
  JuryAppointmentTime = ""
  JuryArrivalTime = "08:45"
  VAENotice = ""
  AuthorizationNotice = ""
]

[TitleSession
  StartDate = ""
  StartTime = ""
  VenueAddress = ""
  EquipmentNotice = ""
  [Title
    Id = 0
    Codename = ""
    Name = ""
    FrName = ""
    EnName = ""
    Code = ""
  ]
]

[Generation
  Date = ""
  Time = ""
  Datetime = ""
]

[Contexts
  [Student
    Type = "student"
    Prefix = "Student"
    Label = "Candidat"
    Auto = "Owner"
    Required = 1
  ]
  [TitleSession
    Type = "title_session"
    Prefix = "TitleSession"
    Label = "Session de certification"
    Placeholder = "ID de la session de titre"
  ]
  [Certification
    Type = "title"
    Prefix = "TitleSession.Title"
    Label = "Certification"
    Required = 1
    InferFrom = "TitleSession"
    Placeholder = "id ou nom de code de la certification"
  ]
  [School
    Type = "school"
    Prefix = "School"
    Label = "École"
    Required = 1
    InferFrom = "Student,TitleSession"
  ]
  [SessionManager
    Type = "user"
    Prefix = "SessionManager"
    Label = "Responsable de session"
    Required = 1
    Signatory = "SessionManager"
    InferFrom = "TitleSession"
    Placeholder = "id ou nom de code"
  ]
]

[Signatures
  [SessionManager
    Required = 1
    Role = "Responsable de session"
  ]
]

[Header
  Left = [Text($,Left)
    [@Size;5] Convocation à une session de certification
  Left]
]

[FormLabel
  [Destinataire
    Label = "Candidat"
    [Student
      Identity = "Nom et prénom"
      Address = "Adresse"
      PostalCity = "Code postal et ville"
      Country = "Pays"
      Gender = "Genre"
    ]
    [Candidate
      Number = "Numéro de candidat"
      QuestionnaireDate = "Date du premier rendez-vous"
      QuestionnaireTime = "Heure du premier rendez-vous"
      JuryDate = "Date de passage devant le jury"
      JuryAppointmentTime = "Heure de passage devant le jury"
      JuryArrivalTime = "Heure de présence demandée"
      VAENotice = "Mention VAE, le cas échéant"
      AuthorizationNotice = "Habilitation ou autre justificatif, le cas échéant"
    ]
  ]
  [Emission
    Label = "Émission de la convocation"
    [Generation
      Date = "Date d'émission"
    ]
    [Signatories
      [SessionManager
        Identity = "Responsable de session"
      ]
    ]
  ]
  [SessionTitre
    Label = "Certification et session"
    [TitleSession
      StartDate = "Date de début de session"
      StartTime = "Heure de début de session"
      VenueAddress = "Adresse du centre d'examen"
      EquipmentNotice = "Équipements de protection individuelle, le cas échéant"
      [Title
        FrName = "Certification"
        Code = "Code de la certification"
      ]
    ]
  ]
]

From = [Text($,From)
  [#Variable;School.Name]\par
  [#Variable;School.LegalAddress]\par
  [#Variable;School.Phone]\par
  [#Variable;School.Mail]
From]

Target = [Text($,Target)
  [#Variable;Student.Identity]\par
  [#IfC;Candidate.Number;!=;;Candidat n° [#Variable;Candidate.Number]\par]
  [#Variable;Student.Address]\par
  [#Variable;Student.PostalCity][@IfC;Student.Country;!=;;\par[#Variable;Student.Country]]
Target]

Subject = [Text($,LetterSubject)
  Objet : Convocation à la certification [#Variable;TitleSession.Title.FrName][@IfC;TitleSession.Title.Code;!=;; ([#Variable;TitleSession.Title.Code])]
LetterSubject]

Date = [Text($,XDate)
  [#IfC;School.LegalCity;!=;;[#Variable;School.LegalCity], ;]le [#Variable;Generation.Date]
XDate]


{Content
  @insert txt ($) "convocation_candidat_certification.txt",
  @insert txt ($) "convocation_candidat_certification_remise.txt"
}
