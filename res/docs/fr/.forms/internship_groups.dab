[Stage
  Label = "Stage et conditions particulières"
  [Fields
    [Internship
      [Nature
        Label = "Nature du stage (pédagogique, réorientation, complémentaire, césure)"
      ]
      [Subject
        Label = "Sujet du stage"
        Required = 1
      ]
      [Purpose
        Type = "textarea"
        Label = "Activités et missions confiées"
        Required = 1
      ]
      [Skills
        Type = "textarea"
        Label = "Compétences à acquérir"
      ]
      [StartDate
        Label = "Date de début"
        Required = 1
      ]
      [EndDate
        Label = "Date de fin"
        Required = 1
      ]
      [DurationInDay
        Type = "computed"
        Label = "Nombre total de jours de présence"
        Required = 1
      ]
      [HourPerDay
        Type = "computed"
        Label = "Heures par jour (rythme habituel)"
      ]
      [DayPerWeek
        Type = "computed"
        Label = "Jours par semaine (rythme habituel)"
      ]
      [DurationInHour
        Type = "computed"
        Label = "Nombre total d’heures de présence"
        Required = 1
      ]
      [Address
        Label = "Adresse précise du lieu du stage"
        Required = 1
      ]
      [ScheduleCalendar
        Type = "internship_calendar"
        Label = "Calendrier détaillé du stage"
        Required = 1
        StartField = "Internship.StartDate"
        EndField = "Internship.EndDate"
        SummaryField = "Internship.Schedule"
      ]
      [Schedule
        Type = "computed"
        Label = "Résumé du calendrier"
        Readonly = 1
      ]
      [Paid
        Type = "radio"
        {Choices "Oui", "Non"}
        {ChoiceValues "Oui", "Non"}
        Label = "Gratification : oui ou non"
        Required = 1
      ]
      [HourlyPayment
        Label = "Gratification horaire (euros)"
      ]
      [TotalPayment
        Type = "computed"
        Label = "Gratification totale prévisionnelle (euros)"
      ]
      [Paiement
        Type = "textarea"
        Label = "Montant mensuel et modalités de versement"
      ]
      [Benefits
        Type = "textarea"
        Label = "Avantages et remboursement des frais"
      ]
      [Leaves
        Type = "textarea"
        Label = "Congés et autorisations d’absence"
      ]
      [SigningCity
        Label = "Ville de signature"
        Required = 1
      ]
      [SigningDate
        Label = "Date de signature"
        Required = 1
      ]
    ]
  ]
]
