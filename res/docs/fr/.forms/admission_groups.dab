[Beneficiaire
  Label = "Bénéficiaire"
  [Fields
    [Student
      [Identity
        Label = "Nom et prénom du bénéficiaire"
      ]
      [BirthDate
        Label = "Date de naissance"
      ]
      [BirthPlace
        Label = "Lieu de naissance"
      ]
      [Nationality
        Label = "Nationalité"
      ]
      [Gender
        Label = "Genre"
      ]
    ]
  ]
]

[Admission
  Label = "Admission"
  [Fields
    [Admission
      [TargetClass
        Label = "Formation / classe d'admission"
      ]
      [TargetYearLabel
        Label = "Année / niveau d'admission"
      ]
      [EntryDate
        Label = "Date d'entrée en formation"
      ]
      [EntryLabel
        Label = "Rentrée envisagée"
      ]
      [SchoolYear
        Label = "Année scolaire"
      ]
      [ProspectRegistrationDate
        Label = "Date d'enregistrement de la candidature"
      ]
      [PaymentConfirmed
        Label = "Paiement enregistré"
      ]
      [IssuePlace
        Label = "Lieu d'émission"
      ]
      [IssueDate
        Label = "Date d'émission"
      ]
      [Reference
        Label = "Référence du document"
      ]
      [AutomaticSignature
        Label = "Ajouter automatiquement la signature de la direction"
      ]
    ]
  ]
]


[FraisAdmission
  Label = "Frais d'admission"
  [Fields
    [Admission
      [RequiredAmount
        Label = "Montant exigible à l'admission"
        Required = 1
        Readonly = 1
      ]
      [PaymentState
        Label = "État du règlement"
        Type = "radio"
        Required = 1
        {Choices
          "Non réglé",
          "Partiellement réglé",
          "Réglé intégralement"
        }
        {ChoiceValues
          "none",
          "partial",
          "full"
        }
      ]
      [PaidAmount
        Label = "Montant déjà réglé (uniquement si paiement partiel)"
      ]
    ]
  ]
]

[Direction
  Label = "Direction"
  [Fields
    [Director
      [Identity
        Label = "Direction / représentant de l'établissement"
      ]
      [Role
        Label = "Qualité du représentant de l'établissement"
      ]
      [Mail
        Label = "Courriel du représentant de l'établissement"
      ]
      [Signature
        Label = "Signature du représentant de l'établissement"
      ]
    ]
  ]
]
