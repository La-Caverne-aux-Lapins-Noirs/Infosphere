[Beneficiaire
  Label = "Bénéficiaire"
  [Fields
    [Student
      [Identity
        Label = "Nom et prénom du bénéficiaire"
      ]
      [BirthDate
        Label = "Date de naissance"
      ]
      [BirthPlace
        Label = "Lieu de naissance"
      ]
      [Nationality
        Label = "Nationalité"
      ]
      [Gender
        Label = "Genre"
      ]
    ]
  ]
]

[Admission
  Label = "Admission"
  [Fields
    [Admission
      [TargetClass
        Label = "Formation / classe d'admission"
      ]
      [TargetYearLabel
        Label = "Année / niveau d'admission"
      ]
      [EntryLabel
        Label = "Rentrée envisagée"
      ]
      [SchoolYear
        Label = "Année scolaire"
      ]
      [ProspectRegistrationDate
        Label = "Date d'enregistrement de la candidature"
      ]
      [PaymentConfirmed
        Label = "Paiement enregistré"
      ]
      [IssuePlace
        Label = "Lieu d'émission"
      ]
      [IssueDate
        Label = "Date d'émission"
      ]
      [Reference
        Label = "Référence du document"
      ]
    ]
  ]
]

[FormationAttestation
  Label = "Précisions sur la formation (facultatif)"
  [Fields
    [Admission
      [CourseTitle
        Label = "Intitulé officiel complet (ex. première année du Bachelor en informatique)"
      ]
      [TrainingRegime
        Label = "Régime de formation (ex. formation initiale, hors alternance)"
      ]
      [StudyPace
        Label = "Rythme des études (ex. temps plein)"
      ]
      [EntryDate
        Label = "Date de début (JJ/MM/AAAA ; vide = rentrée prévue au dossier)"
        Type = "text"
      ]
      [EndDate
        Label = "Date de fin de la période attestée (JJ/MM/AAAA)"
        Type = "text"
      ]
      [TrainingDuration
        Label = "Durée de la période attestée (préciser année ou cursus complet)"
      ]
      [TeachingMode
        Label = "Modalités d'enseignement (ex. en présentiel dans les locaux de l'établissement)"
      ]
      [AdditionalInformation
        Label = "Texte complémentaire à faire figurer sur l'attestation"
        Type = "textarea"
      ]
    ]
  ]
]


[FraisAdmission
  Label = "Frais d'admission"
  [Fields
    [Admission
      [RequiredAmount
        Label = "Montant exigible à l'admission"
        Required = 1
        Readonly = 1
      ]
      [PaymentState
        Label = "État du règlement"
        Type = "radio"
        Required = 1
        {Choices
          "Non réglé",
          "Partiellement réglé",
          "Réglé intégralement"
        }
        {ChoiceValues
          "none",
          "partial",
          "full"
        }
      ]
      [PaidAmount
        Label = "Montant déjà réglé (uniquement si paiement partiel)"
      ]
    ]
  ]
]

[SignatureAttestation
  Label = "Signature et tampon à la génération"
  [Fields
    [Admission
      [AutomaticSignature
        Label = "Apposer la signature de la direction"
        Type = "boolean_checkbox"
        Default = 0
      ]
      [ShowStamp
        Label = "Apposer le tampon de l'école"
        Type = "boolean_checkbox"
        Default = 0
      ]
    ]
  ]
]

[Direction
  Label = "Direction"
  [Fields
    [Director
      [Identity
        Label = "Direction / représentant de l'établissement"
      ]
      [Role
        Label = "Qualité du représentant de l'établissement"
      ]
      [Mail
        Label = "Courriel du représentant de l'établissement"
      ]
      [Signature
        Label = "Signature du représentant de l'établissement"
      ]
    ]
  ]
]
