[Paiement
  Label = "Modalités de paiement"
  {ExcludeModels "contrat_of_alternance.dab", "contrat_cfa.dab"}
  [Fields
    [FirstPaiement
      Type = "radio"
      {Choices "Comptant", "En deux fois"}
      {ChoiceValues "1", "2"}
      Label = "Premier versement"
      Required = 1
    ]
    [Paiement
      Type = "radio"
      {Choices "Comptant", "En deux fois", "En quatre fois", "En douze fois"}
      {ChoiceValues "1", "2", "4", "12"}
      Label = "Règlement des frais de formation"
      Required = 1
    ]
  ]
]

[Bibliotheque
  Label = "Bibliothèque"
  [Fields
    [Library
      Type = "radio"
      {Choices "Oui", "Non"}
      {ChoiceValues "1", "0"}
      Label = "Adhésion au programme de partage de livres"
      Required = 1
    ]
  ]
]

[DroitImage
  Label = "Droit à l'image"
  [Fields
    [Photo
      Type = "radio"
      {Choices "J'autorise", "Je n'autorise pas"}
      {ChoiceValues "1", "0"}
      Label = "Autorisation de droit à l'image"
      Required = 1
    ]
  ]
]

[ParametresContrat
  Label = "Paramètres du contrat"
  [Fields
    [Student
      [SchoolPeriod
        Label = "Année scolaire / période de scolarité"
        Required = 1
      ]
      [Month
        Type = "radio"
        {Choices "Septembre", "Janvier", "Avril", "Autre"}
        {ChoiceValues "September", "January", "April", "Other"}
        Label = "Rentrée"
        Required = 1
      ]
      [Day
        Label = "Jour de rentrée"
      ]
      [OtherMonthDay
        Label = "Autre date de rentrée"
      ]
    ]
    [Certification
      Label = "Certification préparée"
    ]
    [Delay
      Label = "Délai d'accès à la formation"
    ]
    [PriceReduction
      Label = "Réduction tarifaire"
    ]
  ]
]

[Etablissement
  Label = "Établissement"
  [Fields
      [Director
        [Identity
          Label = "Direction / représentant de l'établissement"
        ]
        [Role
          Label = "Qualité du représentant de l'établissement"
        ]
      ]
    [Identification
      Label = "Identification de l'établissement"
    ]
  ]
]
