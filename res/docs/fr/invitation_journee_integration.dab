@include ".base_letter/base.dab"
Title = "Invitation à la journée d'intégration"

[School
  Name = ""
  LegalName = ""
  LegalAddress = ""
  LegalCity = ""
  TrainingAddress = ""
  Phone = ""
  Mail = ""
  DocumentLogo = ""
  MainInfo = ""
  SchoolInfo = ""
  FormationInfo = ""
  AlternationInfo = ""
]

[Student
  Identity = ""
  Address = ""
  PostalCity = ""
  Country = ""
  Gender = ""
]

[Cycle
  Id = 0
  Codename = ""
  Number = 0
  Name = ""
  FrName = ""
  EnName = ""
  FirstDay = ""
  FirstDayDate = ""
  PreparationDay = ""
  PreparationDayDate = ""
  IntegrationDay = ""
  IntegrationDayDate = ""
  SchoolId = 0
]

[IntegrationDay
  ArrivalTime = "09:00"
  AdditionalNotice = ""
]

[Generation
  Date = ""
  Time = ""
  Datetime = ""
]

[Contexts
  [Student
    Type = "student"
    Prefix = "Student"
    Label = "Élève"
    Required = 1
  ]
  [Cycle
    Type = "cycle"
    Prefix = "Cycle"
    Label = "Cycle / trimestre"
    Required = 1
    Placeholder = "id ou nom de code du cycle"
  ]
  [School
    Type = "school"
    Prefix = "School"
    Label = "École"
    Required = 1
    InferFrom = "Cycle"
  ]
  [Director
    Type = "director"
    Prefix = "Director"
    Label = "Directeur signataire"
    Required = 1
    Signatory = "Director"
    InferFrom = "School"
  ]
]

[Signatures
  [Director
    Required = 1
    Role = "Directeur(trice)"
  ]
]

[Header
  Left = [Text($,Left)
    [@Size;5] Invitation à la journée d'intégration
  Left]
]

[FormLabel
  [Destinataire
    Label = "Élève"
    [Student
      Identity = "Nom et prénom"
      Address = "Adresse"
      PostalCity = "Code postal et ville"
      Country = "Pays"
      Gender = "Genre"
    ]
  ]
  [Integration
    Label = "Journée d'intégration"
    [Cycle
      Name = "Cycle / trimestre"
      IntegrationDayDate = "Date de la journée"
      FirstDayDate = "Date de rentrée"
    ]
    [IntegrationDay
      ArrivalTime = "Heure de rendez-vous"
      AdditionalNotice = "Consigne complémentaire"
    ]
  ]
  [Emission
    Label = "Émission de l'invitation"
    [Generation
      Date = "Date d'émission"
    ]
    [Signatories
      [Director
        Identity = "Directeur signataire"
      ]
    ]
  ]
]

From = [Text($,From)
  [#Variable;School.Name]\par
  [#Variable;School.LegalAddress]\par
  [#Variable;School.Phone]\par
  [#Variable;School.Mail]
From]

Target = [Text($,Target)
  [#Variable;Student.Identity]\par
  [#Variable;Student.Address]\par
  [#Variable;Student.PostalCity][@IfC;Student.Country;!=;;\par[#Variable;Student.Country]]
Target]

Subject = [Text($,LetterSubject)
  Objet : Invitation à la journée d'intégration[@IfC;Cycle.Name;!=;; - [#Variable;Cycle.Name]]
LetterSubject]

Date = [Text($,LetterDate)
  [#IfC;School.LegalCity;!=;;[#Variable;School.LegalCity], ;]le [#Variable;Generation.Date]
LetterDate]

{Content
  @insert txt ($) "invitation_journee_integration.txt"
}
