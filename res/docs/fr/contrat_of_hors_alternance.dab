@include ".base_contrat_inscription/main.dab"

Title = "Contrat de formation professionnelle hors alternance"
OF=1

[Signatures
  [Director
    Required = 1
    Role = "Directeur(trice)"
  ]
  [Student
    Required = 1
    Role = "Stagiaire"
  ]
  [Finance
    Required = 1
    Role = "Responsable financier"
  ]
]

Identification = [Text($,Identification)
  $(School.MainInfo)

  $(School.FormationInfo)
  
  Tél: $(School.Phone). E-Mail: $(School.Mail)
  
  Ci-dessous dénommé individuellement « L’ÉTABLISSEMENT » ou « l’EFRITS »
  et le stagiaire souhaitant intégrer la formation :  
Identification]
