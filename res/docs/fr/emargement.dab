Document = "SignInSheet"
Title = "Feuille d'émargement de session"

[SignInSheetLayout
  TopMargin = "1cm"
  BottomMargin = "2cm"
  HeaderHeight = "1cm"
  HeaderGap = "0.45cm"
  FooterHeight = "2cm"
  FooterRuleGap = "0.12cm"
  PeoplePerPage = 30
  TrainerInlineLimit = 8
]

[Contexts
  [School
    Type = "school"
    Prefix = "School"
    Label = "École"
    Required = 1
  ]
]

[School
  Name = ""
  DocumentLogo = ""
  MainInfo = ""
  SchoolInfo = ""
  FormationInfo = ""
  AlternationInfo = ""
  Phone = ""
  Mail = ""
]

[Header
  Left = [Text($,Left)
    [@Size;5]
    Feuille d'émargement de session
  Left]
  Right = [Text($,Right)
    [@IfC;School.DocumentLogo;!=;;
      [@Image;[#Variable;School.DocumentLogo];width=3cm;height=2cm]
    ]
  Right]
]

Footer = [Text($,Footer)
  [@Center;
    [@Size;0]
    $(School.MainInfo)
    $(School.SchoolInfo)
    $(School.FormationInfo)
    $(School.AlternationInfo)
    $(School.Phone) $(School.Mail)
  ]
Footer]
