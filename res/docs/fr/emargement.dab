Document = "SignInSheet"

[Header
  Left = [Text($,Left)
    [@Size;5]
    Feuille d'émargement
  Left]
  Right = [Text($,Right)
    [@Image;[#Variable;Company.Logo];width=3cm;height=2cm]
  Right]
]

Footer = [Text($,Footer)
  [@Size;0]
  $(School.MainInfo)
  $(School.SchoolInfo)
  $(School.FormationInfo)
  $(School.AlternationInfo)
  $(School.Phone) $(School.Mail)
Footer]

