@include ".base_letter/base.dab"
Title = "Convocation d'un membre du jury à une session de certification"

[School
  Name = ""
  LegalName = ""
  LegalAddress = ""
  LegalCity = ""
  TrainingAddress = ""
  Phone = ""
  Mail = ""
  DocumentLogo = ""
  MainInfo = ""
  SchoolInfo = ""
  FormationInfo = ""
  AlternationInfo = ""
]

[Jury
  Identity = ""
  Gender = ""
  Address = ""
  PostalCity = ""
  Country = ""
]

[TitleSession
  StartDate = ""
  EndDate = ""
  StartTime = ""
  EndTime = ""
  JuryArrivalTime = ""
  VenueAddress = ""
  EquipmentNotice = ""
  [Title
    Id = 0
    Codename = ""
    Name = ""
    FrName = ""
    EnName = ""
    Code = ""
  ]
]

[Generation
  Date = ""
  Time = ""
  Datetime = ""
]

[Contexts
  [Jury
    Type = "jury"
    Prefix = "Jury"
    Label = "Membre du jury"
    Required = 1
  ]
  [TitleSession
    Type = "title_session"
    Prefix = "TitleSession"
    Label = "Session de certification"
    Required = 1
    Placeholder = "ID de la session de titre"
  ]
  [Certification
    Type = "title"
    Prefix = "TitleSession.Title"
    Label = "Certification"
    Required = 1
    InferFrom = "TitleSession"
    Placeholder = "id ou nom de code de la certification"
  ]
  [School
    Type = "school"
    Prefix = "School"
    Label = "École"
    Required = 1
    InferFrom = "TitleSession"
  ]
  [SessionManager
    Type = "user"
    Prefix = "SessionManager"
    Label = "Responsable de session"
    Required = 1
    Signatory = "SessionManager"
    InferFrom = "TitleSession"
    Placeholder = "id ou nom de code"
  ]
]

[Signatures
  [SessionManager
    Required = 1
    Role = "Responsable de session"
  ]
]

[Header
  Left = [Text($,Left)
    [@Size;5] Convocation à une session de certification
  Left]
]

Footer = [Text($,Footer)
  [#Center;
    [@Size;0]
    $(School.MainInfo)
    $(School.SchoolInfo)
    $(School.FormationInfo)
    $(School.AlternationInfo)
    $(School.Phone) $(School.Mail)
  ]
Footer]

[FormLabel
  [Destinataire
    Label = "Membre du jury"
    [Jury
      Identity = "Nom et prénom"
      Gender = "Genre"
      Address = "Adresse"
      PostalCity = "Code postal et ville"
      Country = "Pays"
    ]
  ]
  [Emission
    Label = "Émission de la convocation"
    [Generation
      Date = "Date d'émission"
    ]
    [Signatories
      [SessionManager
        Identity = "Responsable de session"
      ]
    ]
  ]
  [SessionTitre
    Label = "Certification et session"
    [TitleSession
      StartDate = "Date de début de session"
      EndDate = "Date de fin de session"
      JuryArrivalTime = "Heure de présence demandée aux membres du jury"
      VenueAddress = "Adresse du centre d'examen"
      EquipmentNotice = "Consigne relative aux équipements, le cas échéant"
      [Title
        FrName = "Certification"
        Code = "Code de la certification"
      ]
    ]
  ]
]

From = [Text($,From)
  [#Variable;School.Name]\par
  [#Variable;School.LegalAddress]\par
  [#Variable;School.Phone]\par
  [#Variable;School.Mail]
From]

Target = [Text($,Target)
  [#Variable;Jury.Identity]\par
  [#Variable;Jury.Address]\par
  [#Variable;Jury.PostalCity][@IfC;Jury.Country;!=;;\\[#Variable;Jury.Country]]
Target]

Subject = [Text($,LetterSubject)
  Objet : Convocation en qualité de membre du jury - [#Variable;TitleSession.Title.FrName][@IfC;TitleSession.Title.Code;!=;; ([#Variable;TitleSession.Title.Code])]
LetterSubject]

Date = [Text($,LetterDate)
  [#IfC;School.LegalCity;!=;;[#Variable;School.LegalCity], ;]le [#Variable;Generation.Date]
LetterDate]

{Content
  @insert txt ($) "convocation_jury.txt"
}
