Document = "Contract"

NoPaiement=0
CFA=0
OF=0
Ecole=0
MinimumSlice=1
MaximumSlice=12
PriceReduction=0

[Workflow
  QueueForPrint = 1
]
 

[Contexts
  [Student
    Type = "student"
    Prefix = "Student"
    Label = "Apprenant"
    Auto = "Owner"
    Required = 1
    Signatory = "Student"
  ]
  [School
    Type = "school"
    Prefix = "School"
    Label = "École"
    Required = 1
    Blank = 1
    InferFrom = "Student"
  ]
  [Director
    Type = "director"
    Prefix = "Director"
    Label = "Directeur signataire"
    Required = 1
    Blank = 1
    Signatory = "Director"
    InferFrom = "School"
  ]
  [Finance
    Type = "finance"
    Prefix = "Finance"
    Label = "Responsable financier"
    Required = 1
    Signatory = "Finance"
    InferFrom = "Student"
  ]
  [Legal1
    Type = "legal1"
    Prefix = "Legal1"
    Label = "Premier responsable légal"
    InferFrom = "Student"
  ]
  [Legal2
    Type = "legal2"
    Prefix = "Legal2"
    Label = "Second responsable légal"
    InferFrom = "Student"
  ]
  [Emergency
    Type = "emergency"
    Prefix = "Emergency"
    Label = "Contact d'urgence"
    InferFrom = "Student"
  ]
]

[Header
  Left = [Text($,Left)
    [@Size;5] $([].Title) [@PageCounter]
  Left]
  Right = [Text($,Right)
    [@Image;[#Variable;School.DocumentLogo];width=3cm;height=2cm]
  Right]
]

Footer = [Text($,Footer)
  [@Size;0]
  $(School.MainInfo)
  $(School.SchoolInfo)
  $(School.FormationInfo)
  $(School.AlternationInfo)
  $(School.Phone) $(School.Mail)
Footer]

