Document = "Report"
Title = "Bulletin"


[Contexts
  [Student
    Type = "student"
    Prefix = "People.Student"
    Label = "Élève"
    Auto = "Owner"
    Required = 1
  ]
  [Financial
    Type = "user"
    Prefix = "People.Tutor"
    Label = "Responsable financier / destinataire"
    InferFrom = "Student"
  ]
  [School
    Type = "school"
    Prefix = "School"
    Label = "École"
    Required = 1
    InferFrom = "Student"
  ]
]

[Header
  Left = [Text($,Left)
    [@Size;5]
    Bulletin de fin de trimestre
  Left]
  Right = [Text($,Right)
    [@IfC;School.DocumentLogo;!=;;
      [@Image;[#Variable;School.DocumentLogo];width=3cm;height=2cm]
    ]
  Right]
]

Footer = [Text($,Footer)
  [@Center;
  [@Size;0]
  $(School.MainInfo)
  $(School.SchoolInfo)
  $(School.FormationInfo)
  $(School.AlternationInfo)
  $(School.Phone) $(School.Mail)
  ]
Footer]

[FormGroup
  @insert "res/docs/fr/.forms/report_groups.dab"
]

[FormRole
  @insert "res/docs/fr/.forms/report_roles.dab"
]
