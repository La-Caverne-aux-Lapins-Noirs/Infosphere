' Mise en page commune des courriers administratifs.
' Les positions From/Target sont exprimées depuis le bord physique de la page.
Document = "Letter"

[Letter
  HeaderHeight = "1cm"
  FromX = "2cm"
  FromY = "2.5cm"
  FromWidth = "7.5cm"
  DateX = "14cm"
  DateY = "10cm"
  DateWith = "7cm"
  TargetX = "11.5cm"
  TargetY = "5cm"
  TargetWidth = "7cm"
  BodyGap = "4cm"
  BodyLeft = "1cm"
  BodyRight = "1cm"
  BottomMargin = "2cm"
  FooterHeight = "2cm"
]

[Header
  Right = [Text($,Right)
    [@IfC;School.DocumentLogo;!=;;
      [@Image;[#Variable;School.DocumentLogo];width=3cm;height=2cm]
    ]
  Right]
]

Footer = [Text($,Footer)
  [@Center;
    [@Size;0]
    $(School.MainInfo)
    $(School.SchoolInfo)
    $(School.FormationInfo)
    $(School.AlternationInfo)
    $(School.Phone) $(School.Mail)
  ]
Footer]
